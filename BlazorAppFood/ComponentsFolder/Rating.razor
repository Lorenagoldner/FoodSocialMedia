@using BlazorAppFood.Repositories

@inject IRecipeRepository RecipeRepository

<div class="card">
    <div class="card-recipe-header">
        @for (int i = 1; i <= 5; i++)
        {
            int index = i;
            <span @onclick="@(() => GiveRating(index))">
                <i class="bi @(index <= ratingValue ? "bi-star-fill" : "bi-star")"></i>
            </span>
        }
    </div>
</div>

@code {

    [Parameter]
    public int idRecipe { get; set; }

    [Parameter]
    public int idUser { get; set; }

    private int ratingValue = 0;
    private int _lastLoadedRecipe = 0;
    private int _lastLoadedUser = 0;

    protected override async Task OnParametersSetAsync()
    {
        if (idRecipe > 0 && idUser > 0
            && (idRecipe != _lastLoadedRecipe || idUser != _lastLoadedUser))
        {
            _lastLoadedRecipe = idRecipe;
            _lastLoadedUser = idUser;

            var existingRating = await RecipeService.GetUserRating(idRecipe, idUser);
            ratingValue = existingRating ?? 0;
        }
    }

    protected async Task GiveRating(int rating)
    {
        ratingValue = rating;
        await RecipeRepository.RatingRecipe(idRecipe, idUser, rating);
    }
}