@using BlazorAppFood.Models
@using BlazorAppFood.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Syncfusion.Blazor.DropDowns
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject Repositories.IUserRepository UserRepository
@inject Repositories.IRecipeRepository RecipeRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<!--Navbar-->
<nav class="navbar">
    <div class="container">
        <a class="navbar-brand-logo" href="/feed">Foodie</a>
        <form class="d-flex justify-content-center">
            <SfAutoComplete TValue="string"
                            TItem="SearchResult"
                            DataSource="@searchResults"
                            Filtering="OnFilter">
                <AutoCompleteTemplates TItem="SearchResult">
                    <ItemTemplate Context="item">
                        <div @onclick="@(() => NavigationManager.NavigateTo(item.Route))">
                            @if (item.Type == "Recipe")
                            {
                                <div class="ename">🍰 @item.Title</div>
                            }
                            else if (item.Type == "Tag")
                            {
                                <div class="ename">🏷️ @item.Title</div>
                            }
                            else if (item.Type == "User")
                            {
                                <div class="ename">👤 @item.Title</div>
                            }
                        </div>
                    </ItemTemplate>
                </AutoCompleteTemplates>
                <AutoCompleteFieldSettings Value="Title"></AutoCompleteFieldSettings>
            </SfAutoComplete>
        </form>

        <div class="dropdown">
            <div class="bar1"></div>
            <div class="bar2"></div>
            <div class="bar3"></div>
            <div class="list-group dropdown-content">
                <NavLink class="nav-link" href="feed" Match="NavLinkMatch.All">
                    <i class="bi bi-house"></i>Home
                </NavLink>
                <NavLink class="nav-link" href="AddRecipe" Match="NavLinkMatch.All">
                    <i class="bi bi-plus-circle"></i>Publicar Receita
                </NavLink>
                <NavLink class="nav-link" href="@($"/myrecipes/{user.Id_User}")" Match="NavLinkMatch.All">
                    <i class="custom-plate-icon"></i>Minhas Receitas
                </NavLink>
                <NavLink class="nav-link" href="grouppage" Match="NavLinkMatch.All">
                    <i class="bi bi-people"></i>Meus Grupos
                </NavLink>
                <NavLink class="nav-link" href="favorites" Match="NavLinkMatch.All">
                    <i class="bi bi-bookmark"></i>Favoritos
                </NavLink>
                <NavLink class="nav-link" href="feed" Match="NavLinkMatch.All">
                    <i class="bi bi-person"></i>A seguir
                </NavLink>
                <NavLink class="nav-link" href="userpage"
                         style="border-top: 1px solid #e2e2e2;"
                         Match="NavLinkMatch.All">
                    <i class="bi bi-gear"></i>A minha conta
                </NavLink>
                <a class="nav-link" href="javascript:void(0)" @onclick="Logout"
                   style="border-top: 1px solid #e2e2e2; cursor: pointer;">
                    <i class="bi bi-door-open"></i>Sair
                </a>
            </div>
        </div>

        <div class="me-2">
            <a href="/profilepage">
                <img src="@(!string.IsNullOrEmpty(user?.UserPhoto) ? user.UserPhoto : "img/default-avatar.svg")"
                     alt=""
                     class="rounded-circle circle-user" width="60" height="60">
            </a>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    public User user = new User();

    private List<SearchResult> searchResults = new();
    private List<SearchResult> filteredResults = new();

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string emailUser = await sessionStorage.GetItemAsync<string>("userEmail");
            if (!string.IsNullOrEmpty(emailUser))
            {
                user = await UserRepository.GetUserInfo(emailUser);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro a carregar utilizador logado: {ex.Message}");
        }

        try
        {
            var recipes = await RecipeRepository.GetAllRecipes();
            foreach (var recipe in recipes)
            {
                searchResults.Add(new SearchResult
                {
                    Title = recipe.NameRecipe,
                    Type = "Recipe",
                    Route = $"/recipepage/{recipe.Id_Recipe}"
                });
            }

            var tags = await RecipeRepository.GetAllTagsAsync();
            foreach (var tag in tags)
            {
                searchResults.Add(new SearchResult
                {
                    Title = tag.NameTag,
                    Type = "Tag",
                    Route = $"/feed/{tag.IdTag}"
                });
            }

            var users = await UserRepository.GetAllUsers();
            foreach (var item in users)
            {
                searchResults.Add(new SearchResult
                {
                    Title = item.Username,
                    Type = "User",
                    Route = $"/ProfilePage/{item.Id_User}"
                });
            }

            filteredResults = searchResults;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro a carregar dados de busca: {ex.Message}");
        }
    }

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/profilepage");
        JSRuntime.InvokeVoidAsync("eval", "window.location.reload();");
    }

    private async Task OnFilter(FilteringEventArgs args)
    {
        string searchText = args.Text?.ToLower() ?? "";
        filteredResults = searchResults
            .Where(x => (x.Title ?? "").ToLower().Contains(searchText))
            .ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider)
            .MarkUserAsLoggedOut();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}

<style>
    .ename {
        display: block !important;
        opacity: .87;
        font-size: 16px;
        margin-top: 8px;
    }

    .user {
        opacity: .54;
        font-size: 14px;
        margin-top: 5px;
        margin-bottom: 7px;
    }

    .custom-plate-icon {
        background-image: url('/img/857681.png');
        width: 20px;
        height: 20px;
        display: inline-block;
        background-size: contain;
        background-repeat: no-repeat;
        margin-right: 8px;
    }
</style>