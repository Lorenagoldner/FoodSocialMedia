@using BlazorAppFood.Models
@using BlazorAppFood.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Syncfusion.Blazor.DropDowns
@using System
@using System.Threading

@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject Repositories.IUserRepository UserRepository
@inject Repositories.IRecipeRepository RecipeRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject INotificationRepository NotificationRepository

<!--Navbar-->
<nav class="fd-nav">
    <div class="fd-nav__inner">

        <a class="fd-brand" href="/feed">
            <span class="fd-brand__dot"></span> Foodie
        </a>

        <div class="fd-search">
            <i class="bi bi-search"></i>
            <SfAutoComplete TValue="string"
                            TItem="SearchResult"
                            DataSource="@searchResults"
                            Filtering="OnFilter"
                            Placeholder="Procurar...">
                <AutoCompleteTemplates TItem="SearchResult">
                    <ItemTemplate Context="item">
                        <div @onclick="@(() => NavigationManager.NavigateTo(item.Route))">
                            @if (item.Type == "Recipe")
                            {
                                <div class="ename">🍰 @item.Title</div>
                            }
                            else if (item.Type == "Tag")
                            {
                                <div class="ename">🏷️ @item.Title</div>
                            }
                            else if (item.Type == "User")
                            {
                                <div class="ename">👤 @item.Title</div>
                            }
                        </div>
                    </ItemTemplate>
                </AutoCompleteTemplates>
                <AutoCompleteFieldSettings Value="Title"></AutoCompleteFieldSettings>
            </SfAutoComplete>
        </div>

        <!-- Menu dropdown -->
        <div class="fd-dd fd-nav-dd">
            <button class="fd-dd-toggle" @onclick="ToggleMenu">
                <i class="bi bi-list" style="font-size:20px"></i>
            </button>
            @if (menuOpen)
            {
                <div class="dd-panel">
                    <NavLink class="dd-item" href="feed" Match="NavLinkMatch.All" @onclick="() => menuOpen = false">
                        <i class="bi bi-house"></i> Home
                    </NavLink>
                    <NavLink class="dd-item" href="AddRecipe" Match="NavLinkMatch.All" @onclick="() => menuOpen = false">
                        <i class="bi bi-plus-circle"></i> Publicar receita
                    </NavLink>
                    <NavLink class="dd-item" href="@($"/myrecipes/{user.Id_User}")" Match="NavLinkMatch.All" @onclick="() => menuOpen = false">
                        <i class="bi bi-journal-text"></i> Minhas receitas
                    </NavLink>
                    <NavLink class="dd-item" href="grouppage" Match="NavLinkMatch.All" @onclick="() => menuOpen = false">
                        <i class="bi bi-people"></i> Meus grupos
                    </NavLink>
                    <NavLink class="dd-item" href="favorites" Match="NavLinkMatch.All" @onclick="() => menuOpen = false">
                        <i class="bi bi-bookmark"></i> Favoritos
                    </NavLink>
                    <div class="dd-divider"></div>
                    <NavLink class="dd-item" href="userpage" Match="NavLinkMatch.All" @onclick="() => menuOpen = false">
                        <i class="bi bi-gear"></i> A minha conta
                    </NavLink>
                    <a class="dd-item" href="javascript:void(0)" @onclick="Logout" style="color:#DC3545">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </div>
            }
        </div>

        <!-- Notificações dropdown -->
        <div class="fd-dd fd-nav-dd">
            <button class="fd-dd-toggle" @onclick="ToggleNotifications" style="position:relative">
                <i class="bi bi-bell"></i>
                @if (notifications.Count(n => !n.IsRead) > 0)
                {
                    <span class="badge-notif">@notifications.Count(n => !n.IsRead)</span>
                }
            </button>
            @if (notifOpen)
            {
                <div class="dd-panel">
                    @if (notifications.Any())
                    {
                        <button class="dd-item" style="color:#DC3545;width:100%;text-align:left;border:none;background:none;cursor:pointer"
                                @onclick="ClearAllNotifications">
                            Limpar todas
                        </button>
                        <div class="dd-divider"></div>
                        @foreach (var notification in notifications.OrderByDescending(n => n.CreatedAt).Take(10))
                        {
                            <div class="dd-item" style="justify-content:space-between">
                                <span style="cursor:pointer;flex:1" @onclick="() => OpenNotification(notification)">
                                    @notification.Message
                                </span>
                                <button style="background:none;border:none;cursor:pointer;color:var(--muted)"
                                        @onclick="() => ClearNotification(notification)">✓</button>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding:10px;font-size:14px;color:var(--muted)">Sem notificações</div>
                    }
                </div>
            }
        </div>

        <!-- Avatar -->
        <a href="/profilepage" style="display:inline-block;width:40px;height:40px;flex-shrink:0">
            @if (!string.IsNullOrEmpty(user?.UserPhoto))
            {
                <img src="@user.UserPhoto" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid #fff;box-shadow:0 0 0 1px var(--line);display:block" />
            }
            else
            {
                <span class="fd-avatar fd-avatar--a" style="width:40px;height:40px;display:block"></span>
            }
        </a>

    </div>
</nav>

@implements IDisposable

@code {
    private PeriodicTimer? notificationTimer;
    private CancellationTokenSource? cancellationTokenSource;

    private bool collapseNavMenu = true;
    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private bool menuOpen = false;
    private bool notifOpen = false;
    private void ToggleMenu() { menuOpen = !menuOpen; notifOpen = false; }
    private void ToggleNotifications() { notifOpen = !notifOpen; menuOpen = false; }

    private List<Notification> notifications = new();

    public User user = new User();

    private List<SearchResult> searchResults = new();
    private List<SearchResult> filteredResults = new();

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task OpenNotification(Notification notification)
    {
        await NotificationRepository.MarkAsRead(notification.Id);

        if (notification.Type == NotificationType.Comment ||
            notification.Type == NotificationType.Favorite ||
            notification.Type == NotificationType.Rating)
        {
            NavigationManager.NavigateTo($"/recipepage/{notification.RelatedEntityId}");
        }
        else if (notification.Type == NotificationType.GroupInvite ||
                 notification.Type == NotificationType.GroupAdmin)
        {
            NavigationManager.NavigateTo($"/grouppage/{notification.RelatedEntityId}");
        }
        else if (notification.Type == NotificationType.Follow)
        {
            NavigationManager.NavigateTo($"/profilepage/{notification.ActorUserId}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string emailUser = await sessionStorage.GetItemAsync<string>("userEmail");
            if (!string.IsNullOrEmpty(emailUser))
            {
                user = await UserRepository.GetUserInfo(emailUser);
                notifications = await NotificationRepository.GetUserNotifications(user.Id_User);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro a carregar utilizador logado: {ex.Message}");
        }

        try
        {
            var recipes = await RecipeRepository.GetAllRecipes();
            foreach (var recipe in recipes)
            {
                searchResults.Add(new SearchResult
                {
                    Title = recipe.NameRecipe,
                    Type = "Recipe",
                    Route = $"/recipepage/{recipe.Id_Recipe}"
                });
            }

            var tags = await RecipeRepository.GetAllTagsAsync();
            foreach (var tag in tags)
            {
                searchResults.Add(new SearchResult
                {
                    Title = tag.NameTag,
                    Type = "Tag",
                    Route = $"/feed/{tag.IdTag}"
                });
            }

            var users = await UserRepository.GetAllUsers();
            foreach (var item in users)
            {
                searchResults.Add(new SearchResult
                {
                    Title = item.Username,
                    Type = "User",
                    Route = $"/ProfilePage/{item.Id_User}"
                });
            }

            filteredResults = searchResults;
            StartNotificationPolling();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro a carregar dados de busca: {ex.Message}");
        }
    }

    private void StartNotificationPolling()
    {
        cancellationTokenSource = new CancellationTokenSource();

        notificationTimer = new PeriodicTimer(TimeSpan.FromSeconds(30)); //verifica a cada 30 segundos

        _ = PollNotificationsAsync(cancellationTokenSource.Token);
    }

    private async Task PollNotificationsAsync(CancellationToken token) //para atualizar notificações em tempo real sem recarregar a página
    {
        try
        {
            while (await notificationTimer.WaitForNextTickAsync(token))
            {
                notifications = await NotificationRepository
                    .GetUserNotifications(user.Id_User);

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // normal ao fechar página
        }
    }

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/profilepage");
        JSRuntime.InvokeVoidAsync("eval", "window.location.reload();");
    }

    private async Task OnFilter(FilteringEventArgs args)
    {
        string searchText = args.Text?.ToLower() ?? "";
        filteredResults = searchResults
            .Where(x => (x.Title ?? "").ToLower().Contains(searchText))
            .ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider)
            .MarkUserAsLoggedOut();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private async Task MarkNotificationAsRead(Notification notification)
    {
        await NotificationRepository.MarkAsRead(notification.Id);

        notifications.Remove(notification);

        await InvokeAsync(StateHasChanged);
    }

    private async Task MarkAllNotificationsAsRead()
    {
        await NotificationRepository.MarkAllAsRead(user.Id_User);

        notifications.Clear();

        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearNotification(Notification notification)
    {
        await NotificationRepository.MarkAsRead(notification.Id);

        notifications.Remove(notification);

        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearAllNotifications()
    {
        await NotificationRepository.MarkAllAsRead(user.Id_User);

        notifications.Clear();

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        cancellationTokenSource?.Cancel();
        notificationTimer?.Dispose();
        cancellationTokenSource?.Dispose();
    }
}

<style>
    .ename {
        display: block !important;
        opacity: .87;
        font-size: 16px;
        margin-top: 8px;
    }

    .user {
        opacity: .54;
        font-size: 14px;
        margin-top: 5px;
        margin-bottom: 7px;
    }

    .custom-plate-icon {
        background-image: url('/img/857681.png');
        width: 20px;
        height: 20px;
        display: inline-block;
        background-size: contain;
        background-repeat: no-repeat;
        margin-right: 8px;
    }
</style>