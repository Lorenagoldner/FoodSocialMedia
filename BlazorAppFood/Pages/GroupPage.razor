@page "/grouppage"
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@inject IGroupRepository GroupRepository
@inject IUserRepository UserRepository
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject NavigationManager NavigationManager

<div class="fd-page-wrap">
    <div class="fd-container">

        <!-- Header -->
        <div class="fd-flex-between fd-mb-3">
            <h1 class="fd-page-title" style="margin:0">Grupos</h1>
            <div class="fd-flex">
                <button class="fd-btn fd-btn-primary" @onclick="ToggleCreateGroupForm">
                    <i class="bi bi-plus-lg"></i> Criar novo grupo
                </button>
                <button class="fd-btn fd-btn-outline" @onclick="@(() => NavigationManager.NavigateTo("/searchgroup"))">
                    <i class="bi bi-search"></i> Procurar grupos
                </button>
            </div>
        </div>

        <!-- Create group form -->
        @if (showCreateGroupForm)
        {
            <div class="fd-card fd-mb-3">
                <div class="fd-card-header">
                    <span><i class="bi bi-plus-circle"></i> Criar novo grupo</span>
                </div>
                <div class="fd-card-body">
                    <div class="fd-form-group">
                        <label class="fd-form-label">Nome do grupo *</label>
                        <input class="fd-form-control" @bind="groupNameInput" placeholder="ex: Cantinho das Sopas" />
                    </div>
                    <div class="fd-form-group">
                        <label class="fd-form-label">Tags (separadas por vírgula)</label>
                        <input class="fd-form-control" @bind="groupTagsInput" placeholder="sopa, conforto, inverno" />
                    </div>
                    <div class="fd-form-group">
                        <label class="fd-form-label">Convidar membros (emails separados por vírgula)</label>
                        <input class="fd-form-control" @bind="inviteEmailsInput" placeholder="amigo@foodie.pt, outro@foodie.pt" />
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div style="background:#FEE2E2;color:#B91C1C;border:1px solid #FECACA;border-radius:var(--r-sm);padding:10px 14px;font-size:13px;margin-bottom:12px">
                            @ErrorMessage
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(SuccessMessage))
                    {
                        <div style="background:#D1FAE5;color:#065F46;border:1px solid #A7F3D0;border-radius:var(--r-sm);padding:10px 14px;font-size:13px;margin-bottom:12px">
                            @SuccessMessage
                        </div>
                    }

                    <div class="fd-flex">
                        <button class="fd-btn fd-btn-success" @onclick="CreateGroup">Criar</button>
                        <button class="fd-btn fd-btn-outline" @onclick="ToggleCreateGroupForm">Cancelar</button>
                    </div>
                </div>
            </div>
        }

        <!-- My groups -->
        <h3 style="font-family:var(--font-display);font-size:18px;margin-bottom:14px">Os meus grupos</h3>

        @if (userGroups != null && userGroups.Any())
        {
            @foreach (var group in userGroups)
            {
                <div style="border:1px solid var(--line);border-radius:var(--r-md);background:var(--surface);margin-bottom:10px;overflow:hidden">
                    <!-- Group row -->
                    <div class="fd-group-item" style="border:none;border-radius:0;margin:0">
                        <span class="fd-group-icon"><i class="bi bi-house"></i></span>
                        <div style="flex:1">
                            <a href="/grouppage/@group.Id_Group" class="fd-group-item__name">@group.Name</a>
                            @if (groupMembers.ContainsKey(group.Id_Group))
                            {
                                <div class="fd-muted fd-small">@groupMembers[group.Id_Group].Count membros</div>
                            }
                        </div>
                        <div class="fd-flex">
                            <button class="fd-btn fd-btn-outline" style="padding:6px 10px;font-size:12px"
                                    @onclick="() => AddUserToGroup(group.Id_Group)">
                                <i class="bi bi-person-plus"></i> Adicionar
                            </button>
                            <button class="fd-btn fd-btn-outline" style="padding:6px 10px;font-size:12px"
                                    @onclick="() => ToggleMemberList(group.Id_Group)">
                                Membros @(showMembers.ContainsKey(group.Id_Group) && showMembers[group.Id_Group] ? "▲" : "▾")
                            </button>
                            @if (isAdminByGroup.ContainsKey(group.Id_Group) && isAdminByGroup[group.Id_Group])
                            {
                                <button class="fd-btn" style="padding:6px 10px;font-size:12px;background:#DC3545;color:#fff;border-color:#DC3545"
                                        @onclick="() => DeleteGroup(group.Id_Group)">
                                    <i class="bi bi-trash"></i> Excluir
                                </button>
                            }
                            else
                            {
                                <button class="fd-btn fd-btn-outline" style="padding:6px 10px;font-size:12px;color:#B45309;border-color:#FCD34D"
                                        @onclick="() => LeaveGroup(group.Id_Group)">
                                    Sair
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Members expandable -->
                    @if (showMembers.ContainsKey(group.Id_Group) && showMembers[group.Id_Group])
                    {
                        <div style="border-top:1px solid var(--line);padding:16px 20px">
                            <p class="fd-form-label" style="margin-bottom:10px">Membros do grupo</p>
                            @if (groupMembers.ContainsKey(group.Id_Group))
                            {
                                <ul class="fd-h-list">
                                    @foreach (var member in groupMembers[group.Id_Group])
                                    {
                                        <li>
                                            @if (!string.IsNullOrEmpty(member.UserPhoto))
                                            {
                                                <img src="@member.UserPhoto" class="fd-avatar fd-avatar--sm" style="object-fit:cover;cursor:pointer"
                                                     @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + member.Id_User))" />
                                            }
                                            else
                                            {
                                                <span class="fd-avatar fd-avatar--sm fd-avatar--a" style="cursor:pointer"
                                                      @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + member.Id_User))"></span>
                                            }
                                            <span style="cursor:pointer;flex:1"
                                                  @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + member.Id_User))">
                                                @member.Username
                                            </span>
                                            @if (member.IsAdmin)
                                            {
                                                <span class="fd-badge-admin">Admin</span>
                                            }
                                            @if (isAdminByGroup.ContainsKey(group.Id_Group) && isAdminByGroup[group.Id_Group] && member.Id_User != currentUserId)
                                            {
                                                <button class="fd-btn fd-btn-outline" style="padding:4px 10px;font-size:12px;margin-left:auto"
                                                        @onclick="() => ConfirmToggleAdmin(member.Id_User, group.Id_Group, member.IsAdmin)">
                                                    @(member.IsAdmin ? "Remover admin" : "Tornar admin")
                                                </button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div style="background:var(--blue-soft);color:#1F4D7A;border:1px solid #B8D0EA;border-radius:var(--r-sm);padding:14px 16px;font-size:14px">
                Ainda não pertences a nenhum grupo.
            </div>
        }

    </div>
</div>

<!-- Modal: add user -->
@if (showModal)
{
    <div class="fd-modal-overlay">
        <div class="fd-modal">
            <h5>Adicionar utilizador ao grupo</h5>
            <div class="fd-form-group">
                <label class="fd-form-label">Email do utilizador</label>
                <input class="fd-form-control" placeholder="utilizador@foodie.pt" @bind="emailToAdd" />
            </div>
            <button class="fd-btn fd-btn-outline" style="margin-bottom:12px" @onclick="PreviewUserByEmail">Verificar</button>

            @if (userPreview != null)
            {
                <div class="fd-flex" style="background:var(--surface-2);padding:12px;border-radius:var(--r-sm);margin-bottom:12px">
                    @if (!string.IsNullOrEmpty(userPreview.UserPhoto))
                    {
                        <img src="@userPreview.UserPhoto" class="fd-avatar fd-avatar--sm" style="object-fit:cover" />
                    }
                    else
                    {
                        <span class="fd-avatar fd-avatar--sm fd-avatar--a"></span>
                    }
                    <span style="font-family:var(--font-display);font-weight:600">@userPreview.Username</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div style="background:#FEE2E2;color:#B91C1C;border-radius:var(--r-sm);padding:8px 12px;font-size:13px;margin-bottom:10px">@ErrorMessage</div>
            }

            <div class="fd-modal-footer">
                <button class="fd-btn fd-btn-outline" @onclick="CloseModal">Cancelar</button>
                @if (userPreview != null)
                {
                    <button class="fd-btn fd-btn-success" @onclick="ConfirmAddUser">Confirmar</button>
                }
            </div>
        </div>
    </div>
}

<!-- Modal: confirm admin change -->
@if (showConfirmAdminChange)
{
    <div class="fd-modal-overlay">
        <div class="fd-modal">
            <h5>Confirmar ação</h5>
            <p style="color:var(--ink-2);font-size:14px">
                Tens a certeza de que queres @(pendingMakeAdmin ? "promover" : "remover") este utilizador?
            </p>
            <div class="fd-modal-footer">
                <button class="fd-btn fd-btn-outline" @onclick="CancelAdminChange">Cancelar</button>
                <button class="fd-btn" style="background:#DC3545;color:#fff;border-color:#DC3545" @onclick="ConfirmAdminChange">Confirmar</button>
            </div>
        </div>
    </div>
}

@code {
    private bool showCreateGroupForm = false;
    private string groupNameInput = "";
    private string groupTagsInput = "";
    private string inviteEmailsInput = "";
    private bool showModal = false;
    private string emailToAdd;
    private int groupIdToAddUser;
    private List<Group> userGroups = new();
    private List<Recipe> groupRecipes;
    private Dictionary<int, List<GroupMember>> groupMembers = new();
    private string ErrorMessage = "";
    private string SuccessMessage = "";
    private User userPreview;

    private bool showConfirmAdminChange = false;
    private int pendingUserId;
    private int pendingGroupId;
    private bool pendingMakeAdmin;

    private int currentUserId;
    private Dictionary<int, bool> showMembers = new();
    private Dictionary<int, bool> isAdminByGroup = new();

    private void ToggleMemberList(int groupId)
    {
        if (showMembers.ContainsKey(groupId))
            showMembers[groupId] = !showMembers[groupId];
        else
            showMembers[groupId] = true;
    }

    protected override async Task OnInitializedAsync()
    {
        var email = await sessionStorage.GetItemAsync<string>("userEmail");
        if (string.IsNullOrEmpty(email)) { ErrorMessage = "Sessão expirada."; return; }

        var user = await UserRepository.GetUserByEmail(email);
        if (user == null) { ErrorMessage = "Utilizador não encontrado."; return; }

        currentUserId = user.Id_User;

        await LoadGroups();
        await LoadAdminStatus();
        await LoadGroupRecipes();
    }

    private async Task LoadGroups()
    {
        userGroups = await GroupRepository.GetUserGroups(currentUserId);
        foreach (var group in userGroups)
            await LoadGroupMembers(group.Id_Group);
    }

    private async Task LoadGroupMembers(int groupId)
    {
        groupMembers[groupId] = await GroupRepository.GetGroupMembers(groupId);
    }

    private async Task LoadGroupRecipes()
    {
        groupRecipes = await GroupRepository.GetGroupRecipes(currentUserId);
    }

    private async Task LoadAdminStatus()
    {
        foreach (var group in userGroups)
            isAdminByGroup[group.Id_Group] = await GroupRepository.IsUserAdmin(currentUserId, group.Id_Group);
    }

    private void ToggleCreateGroupForm()
    {
        showCreateGroupForm = !showCreateGroupForm;
        ErrorMessage = "";
        SuccessMessage = "";
    }

    private async Task CreateGroup()
    {
        if (string.IsNullOrWhiteSpace(groupNameInput)) { ErrorMessage = "O nome do grupo é obrigatório."; return; }

        try
        {
            int newGroupId = await GroupRepository.CreateGroup(groupNameInput, currentUserId);

            if (!string.IsNullOrWhiteSpace(inviteEmailsInput))
            {
                var emails = inviteEmailsInput.Split(",", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                foreach (var email in emails)
                {
                    var user = await UserRepository.GetUserByEmail(email);
                    if (user != null)
                    {
                        bool inGroup = await GroupRepository.IsUserInGroup(user.Id_User, newGroupId);
                        if (!inGroup)
                            await GroupRepository.AddUserToGroup(user.Id_User, newGroupId, currentUserId);
                    }
                }
            }

            SuccessMessage = $"Grupo '{groupNameInput}' criado com sucesso!";
            groupNameInput = "";
            groupTagsInput = "";
            inviteEmailsInput = "";
            showCreateGroupForm = false;
            await LoadGroups();
            await LoadAdminStatus();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao criar grupo: {ex.Message}";
        }
    }

    private void AddUserToGroup(int groupId)
    {
        groupIdToAddUser = groupId;
        emailToAdd = "";
        userPreview = null;
        ErrorMessage = "";
        showModal = true;
    }

    private async Task DeleteGroup(int groupId)
    {
        try
        {
            await GroupRepository.DeleteGroup(groupId, currentUserId);
            await LoadGroups();
            await LoadAdminStatus();
        }
        catch (Exception ex) { ErrorMessage = $"Erro ao eliminar grupo: {ex.Message}"; }
    }

    private async Task LeaveGroup(int groupId)
    {
        await GroupRepository.RemoveUserFromGroup(currentUserId, groupId);
        await LoadGroups();
        await LoadAdminStatus();
    }

    private async Task PreviewUserByEmail()
    {
        ErrorMessage = "";
        userPreview = null;
        var user = await UserRepository.GetUserByEmail(emailToAdd);
        if (user == null) { ErrorMessage = "Utilizador não encontrado."; return; }

        bool inGroup = await GroupRepository.IsUserInGroup(user.Id_User, groupIdToAddUser);
        if (inGroup) { ErrorMessage = "Este utilizador já está no grupo."; return; }

        userPreview = user;
    }

    private void CloseModal()
    {
        showModal = false;
        emailToAdd = "";
        userPreview = null;
        ErrorMessage = "";
    }

    private async Task ConfirmAddUser()
    {
        try
        {
            var user = await UserRepository.GetUserByEmail(emailToAdd);
            if (user != null)
            {
                bool inGroup = await GroupRepository.IsUserInGroup(user.Id_User, groupIdToAddUser);
                if (inGroup) { ErrorMessage = $"{user.Username} já está no grupo."; return; }
                await GroupRepository.AddUserToGroup(user.Id_User, groupIdToAddUser, currentUserId);
                await LoadGroups();
                CloseModal();
            }
            else
            {
                ErrorMessage = "Utilizador não encontrado.";
            }
        }
        catch (Exception ex) { ErrorMessage = $"Erro: {ex.Message}"; }
    }

    private void ConfirmToggleAdmin(int userId, int groupId, bool isCurrentlyAdmin)
    {
        pendingUserId = userId;
        pendingGroupId = groupId;
        pendingMakeAdmin = !isCurrentlyAdmin;
        showConfirmAdminChange = true;
    }

    private void CancelAdminChange() => showConfirmAdminChange = false;

    private async Task ConfirmAdminChange()
    {
        await GroupRepository.SetUserAdminStatus(pendingUserId, pendingGroupId, pendingMakeAdmin, currentUserId);
        await LoadGroupMembers(pendingGroupId);
        showConfirmAdminChange = false;
    }
}
