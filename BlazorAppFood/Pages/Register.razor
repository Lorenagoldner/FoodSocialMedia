@using BlazorAppFood.Auth
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@inject IRegisterRepository RegisterRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject ILoginService LoginService


<div class="modal fade @(isOpen ? "show d-block" : "")"
     tabindex="-1"
     aria-labelledby="registerModalLabel">

    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <h5 class="modal-title">Registo</h5>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseModal">
                </button>
            </div>

            <!-- FORM -->
            <EditForm Model="@registerRequest" OnValidSubmit="@MakeNewRegist">
                <DataAnnotationsValidator />

                <div class="modal-body">

                    <!-- USERNAME -->
                    <div class="mb-3">
                        <label for="inputUsername" class="form-label">
                            Username
                        </label>

                        <InputText @bind-Value="registerRequest.Username"
                                   class="form-control"
                                   id="inputUsername" />

                        <ValidationMessage For="@(() => registerRequest.Username)"
                                           class="text-danger" />
                    </div>

                    <!-- EMAIL -->
                    <div class="mb-3">
                        <label for="inputEmail" class="form-label">
                            Endereço de Email
                        </label>

                        <InputText @bind-Value="registerRequest.Email"
                                   class="form-control"
                                   id="inputEmail" />

                        <ValidationMessage For="@(() => registerRequest.Email)"
                                           class="text-danger" />
                    </div>

                    <!-- PASSWORD -->
                    <div class="mb-3">
                        <label for="inputPassword" class="form-label">
                            Password
                        </label>

                        <InputText @bind-Value="registerRequest.Password"
                                   type="password"
                                   class="form-control"
                                   id="inputPassword" />

                        <ValidationMessage For="@(() => registerRequest.Password)"
                                           class="text-danger" />
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="mb-3">
                        <label for="inputConfirmPassword" class="form-label">
                            Repetir Password
                        </label>

                        <InputText @bind-Value="registerRequest.ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   id="inputConfirmPassword" />

                        <ValidationMessage For="@(() => registerRequest.ConfirmPassword)"
                                           class="text-danger" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">
                            @errorMessage
                        </div>
                    }

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-dark">
                        Registe-se
                    </button>

                    <span>Já está registado?</span>
                </div>

            </EditForm>
        </div>
    </div>
</div>

@if (isOpen)
{
    <div class="modal-backdrop fade show"></div>
}
@code {

    public RegisterRequest registerRequest = new RegisterRequest();

    public string errorMessage = "";

    private bool isOpen = false;

    public void OpenModal()
    {
        isOpen = true;
        errorMessage = "";
        StateHasChanged();
    }

    public void CloseModal()
    {
        isOpen = false;
        StateHasChanged();
    }

    public async Task MakeNewRegist()
    {
        errorMessage = "";

        
        bool emailJaExiste =
            await RegisterService.EmailExists(registerRequest.Email);

        if (emailJaExiste)
        {
            errorMessage =
                "An account with this email already exists. Try logging in.";

            return;
        }

  
        bool success =
            await RegisterService.CreateRegist(
                registerRequest.Username,
                registerRequest.Email,
                registerRequest.Password
            );

        if (!success)
        {
            errorMessage =
                "Error creating account. Please try again.";

            return;
        }

        bool loginSuccess =
            await LoginService.LogUser(
                registerRequest.Email,
                registerRequest.Password
            );

        if (!loginSuccess)
        {
            errorMessage =
                "Account created, but automatic login failed. Please log in manually.";

            return;
        }

        ((CustomAuthenticationStateProvider)
            AuthenticationStateProvider)
            .MarkUserAsAuthenticated(registerRequest.Email);

        await sessionStorage.SetItemAsync(
            "userEmail",
            registerRequest.Email
        );

        isOpen = false;

        NavigationManager.NavigateTo("/welcome");
    }
}