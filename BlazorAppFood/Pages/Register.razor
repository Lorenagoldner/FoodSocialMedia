@using BlazorAppFood.Data
@using BlazorAppFood.Models
@inject IRegisterService RegisterService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage


<div class="modal fade @(isOpen ? "show d-block" : "")"
     tabindex="-1"
     aria-labelledby="registerModalLabel">

    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <h5 class="modal-title">Registo</h5>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseModal">
                </button>
            </div>

            <!-- FORM -->
            <EditForm Model="@user" OnValidSubmit="MakeNewRegist">

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <InputText class="form-control"
                                   @bind-Value="user.Username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control"
                                   @bind-Value="user.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="user.Password" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Repetir Password</label>
                        <input type="password" class="form-control" />
                    </div>

                    @if (showErrorRegister)
                    {
                        <div class="alert alert-danger">
                            Erro ao registar utilizador
                        </div>
                    }

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button type="submit" class="btn btn-dark">
                        Registar
                    </button>
                </div>

            </EditForm>

        </div>
    </div>
</div>

@if (isOpen)
{
    <div class="modal-backdrop fade show"></div>
}
@code {

    private User user = new User();
    private bool showErrorRegister = false;
    private bool isOpen = false;

    public void OpenModal()
    {
        isOpen = true;
        showErrorRegister = false;
        StateHasChanged();
    }

    public void CloseModal()
    {
        isOpen = false;
        StateHasChanged();
    }

    public async Task MakeNewRegist()
    {
        bool success = await RegisterService.CreateRegist(
            user.Username,
            user.Email,
            user.Password);

        if (success)
        {
            bool loginSuccess = await RegisterService.LoginRegist(
                user.Email,
                user.Password);

            if (loginSuccess)
            {
                ((CustomAuthenticationStateProvider)AuthenticationStateProvider)
                    .MarkUserAsAuthenticated(user.Email);

                await sessionStorage.SetItemAsync("emailAddress", user.Email);

                isOpen = false;

                NavigationManager.NavigateTo("/welcome");
            }
            else
            {
                showErrorRegister = true;
            }
        }
        else
        {
            showErrorRegister = true;
        }
    }
}