@using BlazorAppFood.Auth
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@inject IRegisterRepository RegisterRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject ILoginRepository LoginRepository

<div class="modal fade @(isOpen ? "show d-block" : "")"
     tabindex="-1"
     aria-labelledby="registerModalLabel">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Register</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>

            <EditForm Model="@registerRequest" OnValidSubmit="@MakeNewRegist">
                <DataAnnotationsValidator />

                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label for="inputUsername" class="form-label">Username</label>
                        <InputText @bind-Value="registerRequest.Username"
                                   class="form-control"
                                   id="inputUsername" />
                        <ValidationMessage For="@(() => registerRequest.Username)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="inputEmail" class="form-label">Email Address</label>
                        <InputText @bind-Value="registerRequest.Email"
                                   class="form-control"
                                   id="inputEmail" />
                        <ValidationMessage For="@(() => registerRequest.Email)" class="text-danger" />
                    </div>

                   <div class="mb-3">
    <label for="inputPassword" class="form-label">Password</label>
                        <input type="password"
                               class="form-control"
                               id="inputPassword"
                               value="@registerRequest.Password"
                               @oninput="@(e => registerRequest.Password = e.Value?.ToString())" />
    <ValidationMessage For="@(() => registerRequest.Password)" class="text-danger" />

    @if (!string.IsNullOrEmpty(registerRequest.Password))
    {
        <!-- Barra de força -->
        <div class="mt-2">
            <div class="progress" style="height: 6px;">
                <div class="progress-bar @PasswordStrengthColor"
                     style="width: @(PasswordStrengthPercent)%">
                </div>
            </div>
            <small class="@("text-" + PasswordStrengthColor.Replace("bg-",""))">
                @PasswordStrengthLabel
            </small>
        </div>

        <!-- Checklist de requisitos -->
        <ul class="list-unstyled mt-2 small">
            <li class="@(HasMinLength ? "text-success" : "text-muted")">
                @(HasMinLength ? "✔" : "✖") Pelo menos 8 caracteres
            </li>
            <li class="@(HasUpper ? "text-success" : "text-muted")">
                @(HasUpper ? "✔" : "✖") Pelo menos uma letra maiúscula
            </li>
            <li class="@(HasLower ? "text-success" : "text-muted")">
                @(HasLower ? "✔" : "✖") Pelo menos uma letra minúscula
            </li>
            <li class="@(HasDigit ? "text-success" : "text-muted")">
                @(HasDigit ? "✔" : "✖") Pelo menos um número
            </li>
            <li class="@(HasSpecial ? "text-success" : "text-muted")">
                @(HasSpecial ? "✔" : "✖") Pelo menos um carácter especial
            </li>
        </ul>
    }
</div>

                    <div class="mb-3">
                        <label for="inputConfirmPassword" class="form-label">Confirm Password</label>
                        <InputText @bind-Value="registerRequest.ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   id="inputConfirmPassword" />
                        <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" class="text-danger" />
                    </div>

                    <hr class="my-3" />

                    <div class="mb-3">
                        <label for="securityQuestion" class="form-label fw-semibold">Security Question</label>
                        <InputSelect @bind-Value="registerRequest.SecurityQuestion" class="form-select" id="securityQuestion">
                            <option value="">Choose a Question...</option>
                            @foreach (var question in securityQuestions)
                            {
                                <option value="@question">@question</option>
                            }
                        </InputSelect>
                        
                        @if (showQuestionError)
                        {
                            <span class="text-danger small d-block mt-1">
                                Please select a security question.
                            </span>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="inputSecurityAnswer" class="form-label">Your Answer</label>
                        <InputText @bind-Value="registerRequest.SecurityAnswer"
                                   class="form-control"
                                   id="inputSecurityAnswer"
                                   placeholder="Type your answer" />
                        <ValidationMessage For="@(() => registerRequest.SecurityAnswer)" class="text-danger" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-dark"
                                disabled="@(!(HasMinLength && HasUpper && HasLower && HasDigit && HasSpecial))">
                        Sign Up
                    </button>
                    <span>Already have an account?</span>
                </div>

            </EditForm>
        </div>
    </div>
</div>

@if (isOpen)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    public RegisterRequest registerRequest = new RegisterRequest();
    public string errorMessage = "";
    private bool isOpen = false;
    private bool showQuestionError = false;
    // Requisitos individuais
    private bool HasMinLength => (registerRequest.Password?.Length ?? 0) >= 8;
    private bool HasUpper => registerRequest.Password?.Any(char.IsUpper) ?? false;
    private bool HasLower => registerRequest.Password?.Any(char.IsLower) ?? false;
    private bool HasDigit => registerRequest.Password?.Any(char.IsDigit) ?? false;
    private bool HasSpecial => registerRequest.Password?.Any(c => !char.IsLetterOrDigit(c)) ?? false;

    // Conta quantos requisitos estão cumpridos
    private int MetCount => new[] { HasMinLength, HasUpper, HasLower, HasDigit, HasSpecial }
                                .Count(x => x);

    // Força da password
    private string PasswordStrengthLabel => MetCount switch
    {
        <= 2 => "Fraca",
        <= 4 => "Média",
        _ => "Forte"
    };

    private string PasswordStrengthColor => MetCount switch
    {
        <= 2 => "bg-danger",
        <= 4 => "bg-warning",
        _ => "bg-success"
    };

    private int PasswordStrengthPercent => MetCount switch
    {
        1 => 20,
        2 => 40,
        3 => 60,
        4 => 80,
        5 => 100,
        _ => 0
    };

    private readonly List<string> securityQuestions = new()
    {
        "What is your favorite color?",
        "What was your favorite toy as a child?",
        "Who is your favorite superhero?",
        "What is your favorite food?",
        "What was the name of your first pet?",
        "What city were you born in?",
        "What is your mother's first name?",
        "What was the name of your first school?",
        "What is your favorite movie?",
        "What was your childhood nickname?"
    };

    public void OpenModal()
    {
        isOpen = true;
        errorMessage = "";
        showQuestionError = false;
        StateHasChanged();
    }

    public void CloseModal()
    {
        isOpen = false;
        StateHasChanged();
    }

    public async Task MakeNewRegist()
    {
        errorMessage = "";
        showQuestionError = false;

        if (string.IsNullOrWhiteSpace(registerRequest.SecurityQuestion))
        {
            showQuestionError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(registerRequest.SecurityAnswer))
        {
            errorMessage = "Please provide an answer to the security question.";
            return;
        }

        bool emailJaExiste = await RegisterRepository.EmailExists(registerRequest.Email);

        if (emailJaExiste)
        {
            errorMessage = "An account with this email already exists. Try logging in.";
            return;
        }

        bool success = await RegisterRepository.CreateRegist(
            registerRequest.Username,
            registerRequest.Email,
            registerRequest.Password,
            registerRequest.SecurityQuestion,
            registerRequest.SecurityAnswer
        );

        if (!success)
        {
            errorMessage = "Error creating account. Please try again.";
            return;
        }

        bool loginSuccess = await LoginRepository.LogUser(
            registerRequest.Email,
            registerRequest.Password
        );

        if (!loginSuccess)
        {
            errorMessage = "Account created, but automatic login failed. Please log in manually.";
            return;
        }

        ((CustomAuthenticationStateProvider)AuthenticationStateProvider)
            .MarkUserAsAuthenticated(registerRequest.Email);

        await sessionStorage.SetItemAsync("userEmail", registerRequest.Email);

        isOpen = false;
        NavigationManager.NavigateTo("/welcome");
    }
}