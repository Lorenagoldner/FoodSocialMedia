@page "/forgot-password"
@using BlazorAppFood.Repositories
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh; background-color: #f8f9fa;">
    <div class="card shadow-sm p-4" style="max-width: 440px; width: 100%;">

        <h4 class="fw-bold text-center mb-1">Recuperar Password</h4>
        <p class="text-muted text-center small mb-4">Responde à tua pergunta de segurança</p>

        <!-- STEP 1: Introduzir email -->
        @if (step == 1)
        {
            <EditForm Model="@emailModel" OnValidSubmit="LoadSecurityQuestion">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Email da conta</label>
                    <InputText class="form-control"
                               @bind-Value="emailModel.Email"
                               placeholder="exemplo@email.com" />
                    <ValidationMessage For="@(() => emailModel.Email)" class="text-danger small" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 small">@errorMessage</div>
                }

                <button type="submit" class="btn btn-dark w-100">Continuar</button>
            </EditForm>
        }

        <!-- STEP 2: Responder à pergunta de segurança -->
        @if (step == 2)
        {
            <EditForm Model="@answerModel" OnValidSubmit="ValidateAnswer">
                <DataAnnotationsValidator />

                <div class="alert alert-secondary py-2 small mb-3">
                    <strong>Pergunta:</strong> @securityQuestion
                </div>

                <div class="mb-3">
                    <label class="form-label">A tua resposta</label>
                    <InputText class="form-control"
                               @bind-Value="answerModel.Answer"
                               placeholder="Resposta à pergunta de segurança" />
                    <ValidationMessage For="@(() => answerModel.Answer)" class="text-danger small" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 small">@errorMessage</div>
                }

                <button type="submit" class="btn btn-dark w-100">Verificar</button>
            </EditForm>
        }

        <!-- STEP 3: Definir nova password -->
        @if (step == 3)
        {
            <div class="alert alert-success py-2 small mb-3">
                ✅ Identidade verificada! Define a tua nova password.
            </div>

            <EditForm Model="@passwordModel" OnValidSubmit="ResetPassword">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Nova Password</label>
                    <InputText class="form-control"
                               type="password"
                               @bind-Value="passwordModel.NewPassword"
                               placeholder="Mínimo 6 caracteres" />
                    <ValidationMessage For="@(() => passwordModel.NewPassword)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar Password</label>
                    <InputText class="form-control"
                               type="password"
                               @bind-Value="passwordModel.ConfirmPassword"
                               placeholder="Repete a nova password" />
                    <ValidationMessage For="@(() => passwordModel.ConfirmPassword)" class="text-danger small" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 small">@errorMessage</div>
                }

                <button type="submit" class="btn btn-dark w-100">Guardar Password</button>
            </EditForm>
        }

        <!-- STEP 4: Sucesso -->
        @if (step == 4)
        {
            <div class="text-center">
                <div style="font-size: 3rem;">🎉</div>
                <h5 class="fw-bold mt-2">Password alterada!</h5>
                <p class="text-muted small">A tua password foi redefinida com sucesso.</p>
                <button class="btn btn-dark rounded-pill px-4 mt-2" @onclick="GoToHome">
                    Fazer Login
                </button>
            </div>
        }

        <!-- Link voltar -->
        @if (step < 4)
        {
            <div class="text-center mt-3">
                <a href="/" class="text-muted small text-decoration-none">← Voltar ao início</a>
            </div>
        }

    </div>
</div>

@code {

    // ── Estado do wizard ────────────────────────────────────────────────────────
    private int step = 1;
    private string errorMessage = "";
    private string securityQuestion = "";
    private string userEmail = "";

    // ── Modelos de cada step ────────────────────────────────────────────────────
    private EmailModel emailModel = new();
    private AnswerModel answerModel = new();
    private NewPasswordModel passwordModel = new();

    // ── STEP 1: carregar pergunta pelo email ────────────────────────────────────
    private async Task LoadSecurityQuestion()
    {
        errorMessage = "";

        var result = await UserRepository.GetSecurityQuestion(emailModel.Email);

        if (result == null)
        {
            errorMessage = "Não existe nenhuma conta com esse email.";
            return;
        }

        if (string.IsNullOrWhiteSpace(result))
        {
            errorMessage = "Esta conta não tem pergunta de segurança configurada.";
            return;
        }

        userEmail = emailModel.Email;
        securityQuestion = result;
        step = 2;
    }

    // ── STEP 2: validar resposta ────────────────────────────────────────────────
    private async Task ValidateAnswer()
    {
        errorMessage = "";

        bool correct = await UserRepository.ValidateSecurityAnswer(userEmail, answerModel.Answer);

        if (!correct)
        {
            errorMessage = "Resposta incorreta. Tenta novamente.";
            return;
        }

        step = 3;
    }

    // ── STEP 3: guardar nova password ───────────────────────────────────────────
    private async Task ResetPassword()
    {
        errorMessage = "";

        if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
        {
            errorMessage = "As passwords não coincidem.";
            return;
        }

        if (passwordModel.NewPassword.Length < 6)
        {
            errorMessage = "A password deve ter pelo menos 6 caracteres.";
            return;
        }

        bool success = await UserRepository.ResetPassword(userEmail, passwordModel.NewPassword);

        if (!success)
        {
            errorMessage = "Erro ao guardar a password. Tenta novamente.";
            return;
        }

        step = 4;
    }

    private void GoToHome() => NavigationManager.NavigateTo("/");

    // ── Modelos locais (validação simples inline) ───────────────────────────────
    public class EmailModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O email é obrigatório.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Email inválido.")]
        public string Email { get; set; } = "";
    }

    public class AnswerModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A resposta é obrigatória.")]
        public string Answer { get; set; } = "";
    }

    public class NewPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A password é obrigatória.")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Mínimo 6 caracteres.")]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Confirma a password.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
