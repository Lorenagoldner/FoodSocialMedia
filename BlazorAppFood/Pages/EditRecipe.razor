@page "/editrecipe/{id:int}"

@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@inject IRecipeRepository RecipeRepository
@inject ITagRepository TagRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@inject IUserRepository UserRepository
@inject IJSRuntime JSRuntime

@if (recipe == null)
{
    <p class="fd-muted" style="padding:40px;text-align:center">A carregar...</p>
}
else
{
    <div class="fd-page-wrap">
        <div class="fd-container">

            <h1 class="fd-page-title fd-mb-3">Editar receita</h1>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="background:#FEE2E2;color:#B91C1C;border:1px solid #FECACA;border-radius:var(--r-sm);padding:12px 14px;font-size:14px;margin-bottom:18px">
                    <i class="bi bi-exclamation-circle"></i> @errorMessage
                </div>
            }

            <div class="fd-card">
                <div class="fd-card-body">
                    <EditForm Model="@recipe" OnValidSubmit="@SaveRecipe">

                        <div class="fd-form-group">
                            <label class="fd-form-label">Título</label>
                            <InputText class="fd-form-control" @bind-Value="recipe.NameRecipe" required />
                        </div>

                        <div class="fd-form-group">
                            <label class="fd-form-label">Preparação</label>
                            <InputTextArea class="fd-form-control" @bind-Value="recipe.Preparation" rows="6" />
                        </div>

                        <div class="fd-form-group">
                            <label class="fd-form-label">Foto (opcional)</label>
                            @if (recipe.Image != null && recipe.Image.Length > 0)
                            {
                                <div style="margin-bottom:10px">
                                    <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(recipe.Image)}")"
                                         alt="Imagem atual"
                                         style="max-width:200px;border-radius:var(--r-sm);display:block" />
                                </div>
                            }
                            <InputFile OnChange="HandleFileSelection" class="fd-form-control" />
                            <small class="fd-muted" style="font-size:12px;margin-top:4px;display:block">Se não escolheres uma nova foto, mantém-se a original.</small>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                            <div class="fd-form-group">
                                <label class="fd-form-label">Porções</label>
                                <input type="number" min="1" max="999" @bind="recipe.Servings" class="fd-form-control" required />
                            </div>
                            <div class="fd-form-group">
                                <label class="fd-form-label">Dificuldade</label>
                                <select class="fd-form-select" @bind="recipe.Difficulty">
                                    <option value="@DifficultyLevel.Facil">Fácil</option>
                                    <option value="@DifficultyLevel.Medio">Médio</option>
                                    <option value="@DifficultyLevel.Dificil">Difícil</option>
                                </select>
                            </div>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                            <div class="fd-form-group">
                                <label class="fd-form-label">Tempo de preparação</label>
                                <div class="fd-input-row">
                                    <input type="number" min="1" max="999" @bind="prepTimeValue" class="fd-form-control" />
                                    <select class="fd-form-select" @bind="prepTimeUnit">
                                        <option value="min">Minutos</option>
                                        <option value="h">Horas</option>
                                    </select>
                                </div>
                            </div>
                            <div class="fd-form-group">
                                <label class="fd-form-label">Tempo de cozinhar</label>
                                <div class="fd-input-row">
                                    <input type="number" min="1" max="999" @bind="cookTimeValue" class="fd-form-control" />
                                    <select class="fd-form-select" @bind="cookTimeUnit">
                                        <option value="min">Minutos</option>
                                        <option value="h">Horas</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Ingredients -->
                        <div class="fd-form-group" style="margin-top:8px">
                            <label class="fd-form-label">Ingredientes</label>
                            <div class="fd-input-row" style="margin-bottom:10px">
                                <SfAutoComplete TValue="string" TItem="Ingredient" DataSource="@allIngredients" @bind-Value="@ingredientName">
                                    <AutoCompleteFieldSettings Value="Name"></AutoCompleteFieldSettings>
                                </SfAutoComplete>
                                <button type="button" class="fd-btn fd-btn-outline" style="padding:8px 12px;flex-shrink:0"
                                        @onclick="@(() => AddIngredient(ingredientName))">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            <div style="display:flex;flex-wrap:wrap;gap:6px">
                                @foreach (var ingredient in recipe.Ingredients)
                                {
                                    var ing = ingredient;
                                    <span class="fd-badge fd-badge-outline">
                                        @ing.Name
                                        <button type="button" @onclick="@(() => RemoveIngredient(ing))">×</button>
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Tags -->
                        <div class="fd-form-group" style="margin-top:8px">
                            <label class="fd-form-label">Categorias &amp; tags</label>
                            @foreach (var category in allCategories)
                            {
                                <details class="fd-acc">
                                    <summary>@category.Description</summary>
                                    <div class="fd-acc__body">
                                        <div class="fd-acc__checks">
                                            @foreach (var tag in category.Tags)
                                            {
                                                <label>
                                                    <input type="checkbox"
                                                           checked="@recipe.Tags.Any(t => t.IdTag == tag.IdTag)"
                                                           @onchange="@((ChangeEventArgs e) => ToggleTagSelection(tag.IdTag, e))" />
                                                    #@tag.NameTag
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </details>
                            }
                        </div>

                        <div class="fd-flex" style="gap:10px;margin-top:24px">
                            <button type="submit" class="fd-btn fd-btn-success">
                                <i class="bi bi-check2"></i> Confirmar
                            </button>
                            <button type="button" class="fd-btn fd-btn-outline" @onclick="Cancel">
                                Cancelar
                            </button>
                        </div>

                    </EditForm>
                </div>
            </div>

        </div>
    </div>
}

@code {
    Recipe recipe = new Recipe();
    string ingredientName;
    List<Ingredient> allIngredients = new List<Ingredient>();
    List<CategoryWithTags> allCategories = new List<CategoryWithTags>();
    byte[] _fileBytes = null;
    byte[] _originalImage = null;
    long maxFileSize = 1024 * 1024 * 15;

    [Parameter] public int id { get; set; }
    public int userId { get; set; }
    private User? currentUser;

    private int prepTimeValue = 30;
    private string prepTimeUnit = "min";
    private int cookTimeValue = 30;
    private string cookTimeUnit = "min";

    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        if (id == 0)
        {
            recipe = new Recipe
            {
                Ingredients = new List<Ingredient>(),
                Tags = new List<Tag>()
            };
        }
        else
        {
            recipe = await RecipeRepository.Recipe_GetOne(id);
            recipe.Ingredients ??= new List<Ingredient>();
            recipe.Tags ??= new List<Tag>();
            _originalImage = recipe.Image;

            (prepTimeValue, prepTimeUnit) = SplitMinutes(recipe.Prep_Time);
            (cookTimeValue, cookTimeUnit) = SplitMinutes(recipe.Cook_Time);
        }

        allIngredients = (await RecipeRepository.IngredientList()).ToList();
        allCategories = await TagRepository.GetCategoriesWithTags();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userEmail = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(userEmail))
        {
            currentUser = await UserRepository.GetUserByEmail(userEmail);
            userId = currentUser.Id_User;
        }
    }

    private (int value, string unit) SplitMinutes(int totalMinutes)
    {
        if (totalMinutes >= 60 && totalMinutes % 60 == 0)
            return (totalMinutes / 60, "h");
        return (totalMinutes, "min");
    }

    protected async Task SaveRecipe()
    {
        errorMessage = "";

        if (_fileBytes == null)
            recipe.Image = _originalImage;

        recipe.Prep_Time = prepTimeUnit == "h" ? prepTimeValue * 60 : prepTimeValue;
        recipe.Cook_Time = cookTimeUnit == "h" ? cookTimeValue * 60 : cookTimeValue;

        try
        {
            bool success = await RecipeRepository.UpdateRecipe(recipe);

            if (success && currentUser != null)
                NavigationManager.NavigateTo($"/myrecipes/{currentUser.Id_User}");
            else
            {
                errorMessage = "Erro ao atualizar a receita. Tente novamente.";
                await ScrollToTop();
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            await ScrollToTop();
        }
        catch (Exception)
        {
            errorMessage = "Ocorreu um erro inesperado ao atualizar a receita.";
            await ScrollToTop();
        }
    }

    void Cancel()
    {
        if (currentUser != null)
            NavigationManager.NavigateTo($"/myrecipes/{currentUser.Id_User}");
    }

    protected async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var fileStream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await fileStream.CopyToAsync(ms);
            _fileBytes = ms.ToArray();
            recipe.Image = _fileBytes;
        }
    }

    void AddIngredient(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return;

        var ingredient = allIngredients.FirstOrDefault(i => i.Name.Equals(name.Trim(), StringComparison.OrdinalIgnoreCase))
                         ?? new Ingredient(name.Trim());

        recipe.Ingredients.Add(ingredient);
        ingredientName = "";
    }

    void RemoveIngredient(Ingredient ingredient)
    {
        recipe.Ingredients.Remove(ingredient);
    }

    void ToggleTagSelection(int tagId, ChangeEventArgs e)
    {
        if ((bool)e.Value)
        {
            var tag = allCategories.SelectMany(c => c.Tags).FirstOrDefault(t => t.IdTag == tagId);
            if (tag != null) recipe.Tags.Add(tag);
        }
        else
        {
            var tag = recipe.Tags.FirstOrDefault(t => t.IdTag == tagId);
            if (tag != null) recipe.Tags.Remove(tag);
        }
    }

    private async Task ScrollToTop()
    {
        await JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 0, behavior: 'smooth' })");
    }
}
