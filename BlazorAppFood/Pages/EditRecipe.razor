@page "/editrecipe/{id:int}"

@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@inject IRecipeRepository RecipeRepository
@inject ITagRepository TagRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@inject IUserRepository UserRepository

@if (recipe == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@recipe" OnValidSubmit="@SaveRecipe" class="container">
        <div class="card form-recipe">
            <div class="form-recipe-header">
                <h3>Informações da Receita</h3>
            </div>

            <!-- Recipe Title -->
            <div class="mb-3">
                <label class="form-label">Título da Receita</label>
                <InputText class="form-control" @bind-Value="recipe.NameRecipe" required />
            </div>

            <!-- Recipe Image -->
            <div class="mb-3">
                <label class="form-label">Imagem da Receita</label>
                <InputFile OnChange="HandleFileSelection" class="form-control" />
            </div>

            <!-- Servings -->
            <div class="mb-3">
                <label class="form-label">Rendimento (Porções)</label>
                <input type="number" min="1" max="999" @bind="recipe.Servings" class="form-control" required />
            </div>

            <!-- Difficulty -->
            <div class="mb-3">
                <label class="form-label">Dificuldade</label>
                <select class="form-select" @bind="recipe.Difficulty">
                    <option value="@DifficultyLevel.Facil">Fácil</option>
                    <option value="@DifficultyLevel.Medio">Médio</option>
                    <option value="@DifficultyLevel.Dificil">Difícil</option>
                </select>
            </div>

            <!-- Prep Time -->
            <div class="mb-3">
                <label class="form-label">Tempo de Preparação</label>
                <div class="input-group">
                    <input type="number" min="1" max="999" @bind="prepTimeValue" class="form-control" required />
                    <select class="form-select" @bind="prepTimeUnit" style="max-width: 120px;">
                        <option value="min">Minutos</option>
                        <option value="h">Horas</option>
                    </select>
                </div>
            </div>

            <!-- Cook Time -->
            <div class="mb-3">
                <label class="form-label">Tempo de Cozedura</label>
                <div class="input-group">
                    <input type="number" min="1" max="999" @bind="cookTimeValue" class="form-control" required />
                    <select class="form-select" @bind="cookTimeUnit" style="max-width: 120px;">
                        <option value="min">Minutos</option>
                        <option value="h">Horas</option>
                    </select>
                </div>
            </div>

            <!-- Step-by-Step Instructions -->
            <div class="mb-3">
                <label class="form-label">Passo a Passo</label>
                <InputTextArea class="form-control" @bind-Value="recipe.Preparation" rows="5" />
            </div>

            <hr />

            <!-- Ingredients Section -->
            <div class="col form-ingredients">
                <img src="img/harvest.svg" alt="">
                <label for="inputIngredients" class="form-label">Ingredientes</label>

                <!-- Add New Ingredient -->
                <div class="row">
                    <div class="col-10">
                        <SfAutoComplete TValue="string" TItem="Ingredient" DataSource="@allIngredients" @bind-Value="@ingredientName">
                            <AutoCompleteFieldSettings Value="Name"></AutoCompleteFieldSettings>
                        </SfAutoComplete>
                    </div>

                    <div class="col">
                        <button type="button" @onclick="@(() => AddIngredient(ingredientName))">
                            <i class="bi bi-plus-circle-fill"></i>
                        </button>
                    </div>
                </div>

                <div class="form-ingredients-content">
                    <ul>
                        @foreach (var ingredient in recipe.Ingredients)
                        {
                            <li>
                                <button type="button" class="btn btn-outline-dark">
                                    <span class="ingredient-label">
                                        @ingredient.Name <span @onclick="@( () => RemoveIngredient(ingredient) )">
                                            <strong>x</strong>
                                        </span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <hr />

            <!-- Category Section -->
            <div class="mb-3">
                <label class="form-label">Categoria</label>
                <div class="accordion" id="tagAccordion">
                    @foreach (var category in allCategories)
                    {
                        var collapseId = $"collapse-{category.IdCategory}";
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading-@category.IdCategory">
                                <button class="accordion-button collapsed fw-bold" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">
                                    @category.Description
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading-@category.IdCategory" data-bs-parent="#tagAccordion">
                                <div class="accordion-body">
                                    @foreach (var tag in category.Tags)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="tag-@tag.IdTag"
                                                   value="@tag.IdTag"
                                                   checked="@recipe.Tags.Any(t => t.IdTag == tag.IdTag)"
                                                   @onchange="@((ChangeEventArgs e) => ToggleTagSelection(tag.IdTag, e))" />
                                            <label class="form-check-label" for="tag-@tag.IdTag">
                                                @tag.NameTag
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-success" type="submit">Confirmar</button>
                <button class="btn btn-secondary" type="button" @onclick="@Cancel">Cancelar</button>
            </div>
        </div>
    </EditForm>
}

@code {
    Recipe recipe = new Recipe();
    string ingredientName;
    List<Ingredient> allIngredients = new List<Ingredient>();
    List<CategoryWithTags> allCategories = new List<CategoryWithTags>();
    byte[] _fileBytes = null;
    byte[] _originalImage = null;
    long maxFileSize = 1024 * 1024 * 15;

    [Parameter] public int id { get; set; }
    public int userId { get; set; }
    private User? currentUser;

    private int prepTimeValue = 30;
    private string prepTimeUnit = "min";
    private int cookTimeValue = 30;
    private string cookTimeUnit = "min";

    protected override async Task OnInitializedAsync()
    {
        if (id == 0)
        {
            recipe = new Recipe
                {
                    Ingredients = new List<Ingredient>(),
                    Tags = new List<Tag>()
                };
        }
        else
        {
            recipe = await RecipeRepository.Recipe_GetOne(id);
            recipe.Ingredients ??= new List<Ingredient>();
            recipe.Tags ??= new List<Tag>();
            _originalImage = recipe.Image;

            (prepTimeValue, prepTimeUnit) = SplitMinutes(recipe.Prep_Time);
            (cookTimeValue, cookTimeUnit) = SplitMinutes(recipe.Cook_Time);
        }

        allIngredients = (await RecipeRepository.IngredientList()).ToList();
        allCategories = await TagRepository.GetCategoriesWithTags();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userEmail = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(userEmail))
        {
            currentUser = await UserRepository.GetUserByEmail(userEmail);
            userId = currentUser.Id_User;
        }
    }

    private (int value, string unit) SplitMinutes(int totalMinutes)
    {
        if (totalMinutes >= 60 && totalMinutes % 60 == 0)
            return (totalMinutes / 60, "h");
        return (totalMinutes, "min");
    }

    protected async Task SaveRecipe()
    {
        if (_fileBytes == null)
        {
            recipe.Image = _originalImage;
        }

        recipe.Prep_Time = prepTimeUnit == "h" ? prepTimeValue * 60 : prepTimeValue;
        recipe.Cook_Time = cookTimeUnit == "h" ? cookTimeValue * 60 : cookTimeValue;

        await RecipeRepository.UpdateRecipe(recipe);
        if (currentUser != null)
        {
            NavigationManager.NavigateTo($"/myrecipes/{currentUser.Id_User}");
        }
    }

    void Cancel()
    {
        if (currentUser != null)
        {
            NavigationManager.NavigateTo($"/myrecipes/{currentUser.Id_User}");
        }
    }

    protected async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var fileStream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await fileStream.CopyToAsync(ms);
            _fileBytes = ms.ToArray();
            recipe.Image = _fileBytes;
        }
    }

    void AddIngredient(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return;

        var ingredient = allIngredients.FirstOrDefault(i => i.Name.Equals(name.Trim(), StringComparison.OrdinalIgnoreCase))
                         ?? new Ingredient(name.Trim());

        recipe.Ingredients.Add(ingredient);
        ingredientName = "";
    }

    void RemoveIngredient(Ingredient ingredient)
    {
        recipe.Ingredients.Remove(ingredient);
    }

    void ToggleTagSelection(int tagId, ChangeEventArgs e)
    {
        if ((bool)e.Value)
        {
            var tag = allCategories.SelectMany(c => c.Tags).FirstOrDefault(t => t.IdTag == tagId);
            if (tag != null)
            {
                recipe.Tags.Add(tag);
            }
        }
        else
        {
            var tag = recipe.Tags.FirstOrDefault(t => t.IdTag == tagId);
            if (tag != null)
            {
                recipe.Tags.Remove(tag);
            }
        }
    }
}
