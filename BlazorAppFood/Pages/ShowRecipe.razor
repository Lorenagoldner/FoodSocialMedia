@page "/myrecipes/{userId:int}"

@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@inject IRecipeRepository RecipeRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager

<div class="fd-page-wrap">
    <div class="fd-container">

        <div class="fd-flex-between fd-mb-3">
            <h1 class="fd-page-title" style="margin:0">Receitas de @userName</h1>
            <a href="/addrecipe" class="fd-btn fd-btn-primary">
                <i class="bi bi-plus-lg"></i> Nova receita
            </a>
        </div>

        <AuthorizeView>
            <Authorized>
                @if (recipe == null)
                {
                    <p class="fd-muted">A carregar receitas...</p>
                }
                else if (!recipe.Any())
                {
                    <div style="background:var(--blue-soft);color:#1F4D7A;border:1px solid #B8D0EA;border-radius:var(--r-sm);padding:12px 14px;font-size:14px">
                        Este utilizador ainda não tem receitas publicadas.
                    </div>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:18px">
                        @foreach (var rec in recipe)
                        {
                            var imgSrc = rec.Image != null
                                ? $"data:image/jpeg;base64,{Convert.ToBase64String(rec.Image)}"
                                : null;

                            <div class="fd-card">
                                @if (imgSrc != null)
                                {
                                    <img src="@imgSrc" alt="@rec.NameRecipe"
                                         style="width:100%;height:200px;object-fit:cover;border-top-left-radius:var(--r-lg);border-top-right-radius:var(--r-lg);display:block" />
                                }
                                else
                                {
                                    <div class="fd-img fd-img--a" style="height:200px;border-top-left-radius:var(--r-lg);border-top-right-radius:var(--r-lg)">
                                        <svg viewBox="0 0 200 140" width="60%"><g fill="none" stroke="currentColor" stroke-width="4"><circle cx="100" cy="80" r="40" fill="#fff"/></g></svg>
                                    </div>
                                }
                                <div class="fd-card-body">
                                    <a href="/recipepage/@rec.Id_Recipe"
                                       style="font-family:var(--font-display);font-weight:700;font-size:18px;color:var(--ink);text-decoration:none;display:block;margin-bottom:6px">
                                        @rec.NameRecipe
                                    </a>
                                    <div class="fd-muted fd-small" style="margin-bottom:12px">
                                        <i class="bi bi-clock"></i> @TimeFormatter.FormatMinutes(rec.Prep_Time) prep
                                        &nbsp;·&nbsp;
                                        <i class="bi bi-fire"></i> @TimeFormatter.FormatMinutes(rec.Cook_Time) cozinha
                                    </div>
                                    <div class="fd-flex" style="gap:8px">
                                        <button class="fd-btn fd-btn-outline" style="padding:6px 12px;font-size:13px"
                                                @onclick="@(() => NavigationManager.NavigateTo($"/editrecipe/{rec.Id_Recipe}"))">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                        <button style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;font-size:13px;font-family:var(--font-display);font-weight:600;border-radius:999px;border:none;background:#DC3545;color:#fff;cursor:pointer"
                                                @onclick="@(() => NavigationManager.NavigateTo($"/deleterecipe/{rec.Id_Recipe}"))">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </Authorized>
            <NotAuthorized>
                <p class="fd-muted">Por favor, inicie sessão para ver as receitas.</p>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</div>

@code {
    [Parameter] public int userId { get; set; }

    private IEnumerable<Recipe> recipe;
    private string userName = "";

    protected override async Task OnInitializedAsync()
    {
        var user = await UserRepository.GetUserById(userId);

        if (user != null)
        {
            userName = user.Username;
            recipe = await RecipeRepository.GetRecipesByUserId(userId);
        }
        else
        {
            recipe = new List<Recipe>();
            userName = "desconhecido";
        }
    }
}
