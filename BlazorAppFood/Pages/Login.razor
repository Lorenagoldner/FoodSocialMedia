@using BlazorAppFood.Auth
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@inject ILoginRepository LoginRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage

@if (isOpen)
{
    <div class="fd-auth-overlay">
        <div class="fd-auth-panel">
            <button class="fd-auth-close" @onclick="CloseModal" aria-label="Fechar">
                <i class="bi bi-x-lg"></i>
            </button>

            <h3>Entrar no Foodie</h3>
            <p class="fd-muted fd-small" style="margin-bottom:20px">Que bom voltar a ver-te.</p>

            @if (showErrorLogin)
            {
                <div style="background:#FEE2E2;color:#B91C1C;border:1px solid #FECACA;border-radius:var(--r-sm);padding:10px 14px;font-size:13px;margin-bottom:14px">
                    <i class="bi bi-exclamation-circle"></i> Email ou password incorretos.
                </div>
            }

            <EditForm Model="@user" OnValidSubmit="LoginUser">
                <div class="fd-form-group">
                    <label class="fd-form-label">Email</label>
                    <InputText class="fd-form-control" @bind-Value="user.Email" placeholder="ola@foodie.pt" />
                </div>
                <div class="fd-form-group">
                    <label class="fd-form-label">Password</label>
                    <InputText class="fd-form-control" type="password" @bind-Value="user.Password" placeholder="••••••••" />
                    <div style="text-align:right;margin-top:6px">
                        <a href="javascript:void(0)" @onclick="GoToForgotPassword"
                           style="font-size:12px;color:var(--orange);text-decoration:none;font-weight:500">
                            Esqueceste-te da password?
                        </a>
                    </div>
                </div>

                <button type="submit" class="fd-btn fd-btn-primary fd-btn-block" style="margin-top:8px;padding:12px">
                    Entrar
                </button>

                <p style="text-align:center;margin-top:14px;font-size:13px;color:var(--muted)">
                    Ainda não tens conta?
                    <a href="javascript:void(0)" @onclick="SwitchToRegister" style="color:var(--orange)">Regista-te aqui</a>
                </p>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnOpenRegister { get; set; }

    private User user = new User();
    private bool showErrorLogin = false;
    private bool isOpen = false;

    public void OpenModal()
    {
        isOpen = true;
        showErrorLogin = false;
        StateHasChanged();
    }

    public void CloseModal()
    {
        isOpen = false;
        StateHasChanged();
    }

    private async Task SwitchToRegister()
    {
        CloseModal();
        await OnOpenRegister.InvokeAsync();
    }

    private void GoToForgotPassword()
    {
        CloseModal();
        NavigationManager.NavigateTo("/forgot-password");
    }

    public async Task LoginUser()
    {
        bool userIsValidated = await LoginRepository.LogUser(user.Email, user.Password);

        if (userIsValidated)
        {
            ((CustomAuthenticationStateProvider)AuthenticationStateProvider)
                .MarkUserAsAuthenticated(user.Email);

            await sessionStorage.SetItemAsync("userEmail", user.Email);
            isOpen = false;
            NavigationManager.NavigateTo("/feed");
        }
        else
        {
            showErrorLogin = true;
        }
    }
}
