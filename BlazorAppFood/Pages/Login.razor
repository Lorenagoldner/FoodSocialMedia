@using BlazorAppFood.Auth
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@inject ILoginRepository LoginRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage


<div class="modal fade @(isOpen ? "show d-block" : "")"
     tabindex="-1"
     aria-labelledby="loginModalLabel">

    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <h5 class="modal-title">Login</h5>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseModal">
                </button>
            </div>

            <!-- FORM -->
            <EditForm Model="@user" OnValidSubmit="LoginUser">

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control"
                                   @bind-Value="user.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="user.Password" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 gap-3">

                        <div class="form-check d-flex align-items-center">
                            <input type="checkbox" class="form-check-input me-2" />
                            <label class="form-check-label text-nowrap">
                                Remember me
                            </label>
                        </div>

                        <a href="/forgot-password"
                           class="text-muted small text-decoration-none text-nowrap"
                           @onclick="CloseModal"
                           @onclick:preventDefault="false">
                            Esqueci a senha
                        </a>

                    </div>

                    @if (showErrorLogin)
                    {
                        <div class="alert alert-danger">
                            Email ou password incorretos
                        </div>
                    }

                </div>

                <!-- FOOTER -->
                <div class="modal-footer">
                    <button type="submit" class="btn btn-dark">
                        Login
                    </button>
                </div>

            </EditForm>

        </div>
    </div>
</div>

@if (isOpen)
{
    <div class="modal-backdrop fade show"></div>
}

@code {

    private User user = new User();
    private bool showErrorLogin = false;
    private bool isOpen = false;

    public void OpenModal()
    {
        isOpen = true;
        showErrorLogin = false;
        StateHasChanged();
    }

    public void CloseModal()
    {
        isOpen = false;
        StateHasChanged();
    }

    public async Task LoginUser()
    {
        bool userIsValidated = await LoginRepository.LogUser(user.Email, user.Password);

        if (userIsValidated)
        {
            ((CustomAuthenticationStateProvider)AuthenticationStateProvider)
                .MarkUserAsAuthenticated(user.Email);

            await sessionStorage.SetItemAsync("userEmail", user.Email);

            isOpen = false;

            NavigationManager.NavigateTo("/feed");
        }
        else
        {
            showErrorLogin = true;
        }
    }
}
