@page "/addrecipe"
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Syncfusion.Blazor.DropDowns
@inject IRecipeRepository RecipeRepository
@inject NavigationManager NavigationManager
@inject IUserRepository UserRepository
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject IJSRuntime JSRuntime

<div class="fd-page-wrap">
    <div class="fd-container">

        <h1 class="fd-page-title fd-mb-3">Publicar receita</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="background:#FEE2E2;color:#B91C1C;border:1px solid #FECACA;border-radius:var(--r-sm);padding:12px 14px;font-size:14px;margin-bottom:18px">
                <i class="bi bi-exclamation-circle"></i> @errorMessage
            </div>
        }

        <div class="fd-card">
            <div class="fd-card-body">
                <EditForm Model="@recipe" OnValidSubmit="@CreateRecipe">
                    <div style="display:grid;grid-template-columns:2fr 1fr;gap:32px">

                        <!-- Left column -->
                        <div>
                            <div class="fd-form-group">
                                <label class="fd-form-label">Título *</label>
                                <input type="text" @bind="recipe.NameRecipe" class="fd-form-control" placeholder="ex: Massa com miso e alho crocante" required />
                            </div>

                            <div class="fd-form-group">
                                <label class="fd-form-label">Preparação</label>
                                <textarea @bind="recipe.Preparation" class="fd-form-control" rows="6" placeholder="Não te esqueças de mencionar quantidades, ordens e pequenos truques..."></textarea>
                            </div>

                            <div class="fd-form-group">
                                <label class="fd-form-label">Foto da receita</label>
                                <InputFile OnChange="HandleFileSelection" class="fd-form-control" />
                            </div>

                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                                <div class="fd-form-group">
                                    <label class="fd-form-label">Porções *</label>
                                    <input type="number" min="1" max="999" @bind="recipe.Servings" class="fd-form-control" placeholder="4" required />
                                </div>
                                <div class="fd-form-group">
                                    <label class="fd-form-label">Dificuldade</label>
                                    <select class="fd-form-select" @bind="recipe.Difficulty">
                                        <option value="@DifficultyLevel.Facil">Fácil</option>
                                        <option value="@DifficultyLevel.Medio">Médio</option>
                                        <option value="@DifficultyLevel.Dificil">Difícil</option>
                                    </select>
                                </div>
                            </div>

                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                                <div class="fd-form-group">
                                    <label class="fd-form-label">Tempo de preparação</label>
                                    <div class="fd-input-row">
                                        <input type="number" min="1" max="999" @bind="prepTimeValue" class="fd-form-control" placeholder="10" />
                                        <select class="fd-form-select" @bind="prepTimeUnit">
                                            <option value="min">Minutos</option>
                                            <option value="h">Horas</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="fd-form-group">
                                    <label class="fd-form-label">Tempo de cozinhar</label>
                                    <div class="fd-input-row">
                                        <input type="number" min="1" max="999" @bind="cookTimeValue" class="fd-form-control" placeholder="18" />
                                        <select class="fd-form-select" @bind="cookTimeUnit">
                                            <option value="min">Minutos</option>
                                            <option value="h">Horas</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="fd-btn fd-btn-primary" style="margin-top:8px">
                                <i class="bi bi-upload"></i> Publicar
                            </button>
                        </div>

                        <!-- Right column -->
                        <aside>
                            <p class="fd-form-label" style="margin-bottom:8px">Ingredientes</p>
                            <div class="fd-input-row" style="margin-bottom:10px">
                                <SfAutoComplete TValue="string" TItem="Ingredient" DataSource="@ingredients" @bind-Value="@ingredientName" CssClass="fd-autocomplete">
                                    <AutoCompleteFieldSettings Value="Name"></AutoCompleteFieldSettings>
                                </SfAutoComplete>
                                <button type="button" class="fd-btn fd-btn-outline" style="padding:8px 12px;flex-shrink:0"
                                        @onclick="@(() => AddIngredient(ingredientName))">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>

                            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:18px">
                                @for (int i = 0; i < recipe.Ingredients.Count; i++)
                                {
                                    int index = i;
                                    <span class="fd-badge fd-badge-outline">
                                        @recipe.Ingredients[i].Name
                                        <button type="button" @onclick="@(() => recipe.Ingredients.RemoveAt(index))">×</button>
                                    </span>
                                }
                            </div>

                            <p class="fd-form-label" style="margin-bottom:8px">Categorias &amp; tags</p>

                            @foreach (var category in categories)
                            {
                                <details class="fd-acc">
                                    <summary>@category.Description</summary>
                                    <div class="fd-acc__body">
                                        <div class="fd-acc__checks">
                                            @foreach (var tag in allTags.Where(t => t.IdCategory == category.IdCategory))
                                            {
                                                <label>
                                                    <input type="checkbox"
                                                           checked="@selectedTagIds.Contains(tag.IdTag)"
                                                           @onchange="@((ChangeEventArgs e) => ToggleTagSelection(tag.IdTag, e))" />
                                                    #@tag.NameTag
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </details>
                            }
                        </aside>

                    </div>
                </EditForm>
            </div>
        </div>

    </div>
</div>

@code {

    Recipe recipe = new Recipe();
    byte[] _fileBytes = null;
    long maxFileSize = 1024 * 1024 * 15;
    string ingredientName = "";
    User user = new User();
    IEnumerable<Ingredient> ingredients;

    List<Category> categories = new();
    List<Tag> allTags = new();
    List<Tag> filteredTags = new();

    int selectedCategoryId;
    List<int> selectedTagIds = new();

    private int prepTimeValue = 30;
    private string prepTimeUnit = "min";
    private int cookTimeValue = 30;
    private string cookTimeUnit = "min";

    protected override async Task OnInitializedAsync()
    {
        ingredients = await RecipeRepository.IngredientList();
        string emailUser = await sessionStorage.GetItemAsync<string>("userEmail");

        if (emailUser != null)
        {
            user = await UserRepository.GetUserInfo(emailUser);
            recipe.Id_User = user.Id_User;
        }

        categories = await RecipeRepository.GetAllCategoriesAsync();
        allTags = await RecipeRepository.GetAllTagsAsync();
    }

    string errorMessage = "";

    protected async Task CreateRecipe()
    {
        errorMessage = "";
        recipe.Prep_Time = prepTimeUnit == "h" ? prepTimeValue * 60 : prepTimeValue;
        recipe.Cook_Time = cookTimeUnit == "h" ? cookTimeValue * 60 : cookTimeValue;

        recipe.TagIds = allTags
                .Where(tag => selectedTagIds.Contains(tag.IdTag))
                .Select(tag => tag.IdTag)
                .ToList();

        if (recipe.Image == null || recipe.Image.Length == 0)
        {
            errorMessage = "A receita deve ter uma foto.";
            await ScrollToTop();
            return;
        }

        if (recipe.TagIds == null || !recipe.TagIds.Any())
        {
            errorMessage = "A receita deve ter pelo menos uma categoria.";
            await ScrollToTop();
            return;
        }

        if (recipe.Ingredients == null ||
            !recipe.Ingredients.Any(i => !string.IsNullOrWhiteSpace(i.Name)))
        {
            errorMessage = "A receita deve ter pelo menos um ingrediente.";
            await ScrollToTop();
            return;
        }

        try
        {
            bool success = await RecipeRepository.CreateRecipe(recipe);

            if (success)
                NavigationManager.NavigateTo("/feed");
            else
            {
                errorMessage = "Erro ao guardar a receita. Tente novamente.";
                await ScrollToTop();
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            await ScrollToTop();
        }
    }

    protected async Task HandleFileSelection(InputFileChangeEventArgs files)
    {
        var file = files.File;
        if (file != null)
        {
            using Stream fileStream = file.OpenReadStream(maxFileSize);
            using MemoryStream ms = new();
            await fileStream.CopyToAsync(ms);
            _fileBytes = ms.ToArray();
            recipe.Image = _fileBytes;
        }
    }

    private void AddIngredient(string name)
    {
        if (name.Trim() != "")
        {
            recipe.Ingredients.Add(new Ingredient(name.Trim()));
            ingredientName = "";
        }
    }

    private void ToggleTagSelection(int tagId, ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value;
        if (isChecked)
        {
            if (!selectedTagIds.Contains(tagId))
                selectedTagIds.Add(tagId);
        }
        else
        {
            selectedTagIds.Remove(tagId);
        }
    }

    private async Task ScrollToTop()
    {
        await JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 0, behavior: 'smooth' })");
    }
}
