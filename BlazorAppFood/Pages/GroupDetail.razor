@page "/grouppage/{GroupId:int}"
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage
@using Microsoft.AspNetCore.SignalR.Client
@inject IGroupRepository GroupRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject ISessionStorageService sessionStorage
@implements IAsyncDisposable

<div class="d-flex justify-content-center mt-4">
    <h4>Detalhes do Grupo</h4>
</div>

@if (group != null)
{
    <div class="d-flex justify-content-center">
        <div class="card mb-3" style="width: 100%; max-width: 600px;">
            <div class="card-header text-center">
                <h5>@group.Name</h5>
            </div>
            <div class="card-body">
                <p>@group.Description</p>
                <h6>Membros</h6>
                <ul class="list-group mb-3">
                    @foreach (var member in groupMembers)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <img src="@member.UserPhoto" class="rounded-circle" width="40" height="40" />
                            @member.Username
                            @if (member.IsAdmin)
                            {
                                <span class="badge bg-success ms-1">Admin</span>
                            }
                        </li>
                    }
                </ul>

                @if (isUserAdmin)
                {
                    <div class="mb-2">
                        <button class="btn btn-danger" @onclick="DeleteGroup">Eliminar Grupo</button>
                    </div>
                }

                <div class="mb-4">
                    <button class="btn btn-secondary" @onclick="LeaveGroup">Sair do Grupo</button>
                </div>

                <hr />

                <h6>Chat do Grupo</h6>

                <div class="border rounded p-2 mb-2 bg-light"
                     style="height: 300px; overflow-y: auto; display: flex; flex-direction: column-reverse;"
                     id="chatBox">
                    <div>
                        @foreach (var msg in chatMessages)
                        {
                            <div class="mb-1 d-flex justify-content-between">
                                <div>
                                    <span class="fw-bold">@msg.Username</span>
                                    <span class="text-muted" style="font-size: 0.75rem;"> @msg.Timestamp.ToString("HH:mm")</span>
                                    <div>@msg.Message</div>
                                </div>
                                @if (msg.Username == currentUsername || isUserAdmin)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteMessage(msg.Id)">
                                        🗑
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <input class="form-control"
                           placeholder="Escreve uma mensagem..."
                           @bind="messageInput"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown" />
                    <button class="btn btn-primary"
                            @onclick="SendMessage"
                            disabled="@(!IsConnected)">
                        Enviar
                    </button>
                </div>

                @if (!IsConnected)
                {
                    <p class="text-warning mt-1" style="font-size: 0.8rem;">A ligar ao chat...</p>
                }
            </div>
        </div>
    </div>
}
else
{
    <p>Loading...</p>
}

@code {
    [Parameter] public int GroupId { get; set; }

    private Group group;
    private List<GroupMember> groupMembers = new();
    private bool isUserAdmin = false;

    private HubConnection hubConnection;
    private List<GroupChatMessages> chatMessages = new();
    private string messageInput = "";
    private string currentUsername = "";

    private bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        var email = await sessionStorage.GetItemAsync<string>("userEmail");
        var user = await UserRepository.GetUserByEmail(email);

        currentUsername = user.Username;

        group = await GroupRepository.GetGroupById(GroupId);
        groupMembers = await GroupRepository.GetGroupMembers(GroupId);
        isUserAdmin = groupMembers.Any(m => m.Id_User == user.Id_User && m.IsAdmin);

        chatMessages = await GroupRepository.GetChatMessages(GroupId);

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri($"/groupChatHub?groupId={GroupId}"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<int, string, string, DateTime>("ReceiveMessage",
            (groupId, username, message, timestamp) =>
            {
                chatMessages.Add(new GroupChatMessages
                {
                    Id_Group = groupId,
                    Username = username,
                    Message = message,
                    Timestamp = timestamp
                });
                InvokeAsync(StateHasChanged);
            });

        await hubConnection.StartAsync();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(messageInput) || !IsConnected)
            return;

        await hubConnection.SendAsync("SendMessage", GroupId, currentUsername, messageInput.Trim());
        messageInput = "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessage();
    }

    private async Task LeaveGroup()
    {
        var email = await sessionStorage.GetItemAsync<string>("userEmail");
        var user = await UserRepository.GetUserByEmail(email);
        bool success = await GroupRepository.RemoveUserFromGroup(user.Id_User, GroupId);
        if (success)
            NavigationManager.NavigateTo("/feed");
    }

    private async Task DeleteGroup()
    {
        var email = await sessionStorage.GetItemAsync<string>("userEmail");
        var user = await UserRepository.GetUserByEmail(email);
        bool isAdmin = await GroupRepository.IsUserAdmin(user.Id_User, GroupId);
        if (!isAdmin) return;
        await GroupRepository.DeleteGroup(GroupId, user.Id_User);
        NavigationManager.NavigateTo("/feed");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
    private async Task DeleteMessage(int messageId)
    {
        await GroupRepository.DeleteChatMessage(messageId, currentUsername, isUserAdmin);
        chatMessages.RemoveAll(m => m.Id == messageId);
    }
}