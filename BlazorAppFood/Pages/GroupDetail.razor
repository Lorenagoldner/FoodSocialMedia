@page "/grouppage/{GroupId:int}"
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage
@using Microsoft.AspNetCore.SignalR.Client
@inject IGroupRepository GroupRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject ISessionStorageService sessionStorage
@implements IAsyncDisposable

@if (group == null)
{
    <p class="fd-muted" style="padding:40px;text-align:center">A carregar...</p>
}
else
{
    <div class="fd-page-wrap">
        <div class="fd-container">

            <h1 class="fd-page-title fd-mb-3">Detalhes do grupo</h1>

            <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:24px;align-items:start">

                <!-- Left: info + members -->
                <section>
                    <div class="fd-card">
                        <div class="fd-card-header">
                            <span><i class="bi bi-house" style="color:var(--orange)"></i> @group.Name</span>
                            <span class="fd-badge-member">Membro</span>
                        </div>
                        <div class="fd-card-body">
                            <p style="color:var(--ink-2);font-size:14px;margin-bottom:18px">@group.Description</p>

                            <p class="fd-form-label">Membros</p>
                            <ul class="fd-h-list">
                                @foreach (var member in groupMembers)
                                {
                                    <li style="cursor:pointer" @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + member.Id_User))">
                                        @if (!string.IsNullOrEmpty(member.UserPhoto))
                                        {
                                            <img src="@member.UserPhoto" class="fd-avatar fd-avatar--sm" style="object-fit:cover" />
                                        }
                                        else
                                        {
                                            <span class="fd-avatar fd-avatar--sm fd-avatar--a"></span>
                                        }
                                        <span>@member.Username</span>
                                        @if (member.IsAdmin)
                                        {
                                            <span class="fd-badge-admin" style="margin-left:auto">Admin</span>
                                        }
                                    </li>
                                }
                            </ul>

                            <div class="fd-flex" style="gap:10px;margin-top:20px">
                                @if (isUserAdmin)
                                {
                                    <button class="fd-btn" style="background:#DC3545;color:#fff;border-color:#DC3545" @onclick="DeleteGroup">
                                        <i class="bi bi-trash"></i> Eliminar grupo
                                    </button>
                                }
                                <button class="fd-btn fd-btn-outline" @onclick="LeaveGroup">
                                    Sair do grupo
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Right: chat -->
                <aside>
                    <div class="fd-card">
                        <div class="fd-card-header">
                            <span><i class="bi bi-chat-dots"></i> Conversa do grupo</span>
                            <span class="fd-badge-online">@(IsConnected ? "Online" : "A ligar...")</span>
                        </div>
                        <div class="fd-card-body">
                            <div class="fd-chat">
                                @foreach (var msg in chatMessages)
                                {
                                    <div class="fd-bubble @(msg.Username == currentUsername ? "fd-bubble--me" : "")">
                                        <span class="fd-avatar fd-avatar--xs fd-avatar--a" style="flex-shrink:0"></span>
                                        <div class="fd-bubble__body">
                                            <strong>@msg.Username</strong>
                                            @msg.Message
                                            <time>@msg.Timestamp.ToString("dd/MM/yyyy HH:mm")</time>
                                            @if (msg.Username == currentUsername || isUserAdmin)
                                            {
                                                <button type="button"
                                                        style="background:none;border:none;cursor:pointer;color:var(--muted);font-size:11px;padding:0;margin-top:4px;display:block"
                                                        @onclick="() => DeleteMessage(msg.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="fd-chat-input">
                                <input class="fd-form-control"
                                       type="text"
                                       placeholder="Mensagem ao grupo..."
                                       @bind="messageInput"
                                       @bind:event="oninput"
                                       @onkeydown="HandleKeyDown" />
                                <button class="fd-btn fd-btn-primary" style="padding:8px 14px;flex-shrink:0"
                                        @onclick="SendMessage"
                                        disabled="@(!IsConnected)">
                                    <i class="bi bi-send-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </aside>

            </div>

        </div>
    </div>
}

@code {
    [Parameter] public int GroupId { get; set; }

    private Group group;
    private List<GroupMember> groupMembers = new();
    private bool isUserAdmin = false;

    private HubConnection hubConnection;
    private List<GroupChatMessages> chatMessages = new();
    private string messageInput = "";
    private string currentUsername = "";

    private bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        var email = await sessionStorage.GetItemAsync<string>("userEmail");
        var user = await UserRepository.GetUserByEmail(email);

        currentUsername = user.Username;

        group = await GroupRepository.GetGroupById(GroupId);
        groupMembers = await GroupRepository.GetGroupMembers(GroupId);
        isUserAdmin = groupMembers.Any(m => m.Id_User == user.Id_User && m.IsAdmin);

        chatMessages = await GroupRepository.GetChatMessages(GroupId);

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri($"/groupChatHub?groupId={GroupId}"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<int, string, string, DateTime>("ReceiveMessage",
            (groupId, username, message, timestamp) =>
            {
                chatMessages.Add(new GroupChatMessages
                {
                    Id_Group = groupId,
                    Username = username,
                    Message = message,
                    Timestamp = timestamp
                });
                InvokeAsync(StateHasChanged);
            });

        await hubConnection.StartAsync();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(messageInput) || !IsConnected)
            return;

        await hubConnection.SendAsync("SendMessage", GroupId, currentUsername, messageInput.Trim());
        messageInput = "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessage();
    }

    private async Task LeaveGroup()
    {
        var email = await sessionStorage.GetItemAsync<string>("userEmail");
        var user = await UserRepository.GetUserByEmail(email);
        bool success = await GroupRepository.RemoveUserFromGroup(user.Id_User, GroupId);
        if (success)
            NavigationManager.NavigateTo("/feed");
    }

    private async Task DeleteGroup()
    {
        var email = await sessionStorage.GetItemAsync<string>("userEmail");
        var user = await UserRepository.GetUserByEmail(email);
        bool isAdmin = await GroupRepository.IsUserAdmin(user.Id_User, GroupId);
        if (!isAdmin) return;
        await GroupRepository.DeleteGroup(GroupId, user.Id_User);
        NavigationManager.NavigateTo("/feed");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }

    private async Task DeleteMessage(int messageId)
    {
        await GroupRepository.DeleteChatMessage(messageId, currentUsername, isUserAdmin);
        chatMessages.RemoveAll(m => m.Id == messageId);
    }
}
