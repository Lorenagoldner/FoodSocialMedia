@page "/ProfilePage/{userId:int?}"

@inject IUserRepository UserRepository
@inject IRecipeRepository RecipeRepository
@inject IPostRepository PostRepository
@inject IGroupRepository GroupRepository
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject IChatRepository ChatRepository

@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Microsoft.AspNetCore.Components.Authorization


@if (user == null)
{
    <p>A carregar perfil...</p>
}
else
{
    <div class="fd-page-wrap">
        <div class="fd-container">
            <div class="fd-row fd-row-3col">

                <!-- LEFT: perfil -->
                <aside class="fd-card">
                    <div class="fd-card-body fd-text-center">
                        @if (!string.IsNullOrEmpty(user.UserPhoto))
                        {
                            <img src="@user.UserPhoto" alt="Foto de Perfil"
                                 style="width:120px;height:120px;border-radius:50%;object-fit:cover;margin:0 auto;display:block" />
                        }
                        else
                        {
                            <span class="fd-avatar fd-avatar--xl fd-avatar--a" style="display:block;margin:0 auto"></span>
                        }

                        @if (!isOwnProfile)
                        {
                            @if (!isFollowing)
                            {
                                <button class="fd-btn fd-btn-outline fd-btn-block fd-mt-3" @onclick="FollowUser">
                                    <i class="bi bi-person-plus"></i> Seguir
                                </button>
                            }
                            else
                            {
                                <button class="fd-btn fd-btn-success fd-btn-block fd-mt-3" @onclick="UnfollowUser">
                                    <i class="bi bi-check2"></i> A seguir
                                </button>
                            }
                        }

                        <p class="fd-muted fd-small fd-mt-3">Olá, sou @user.Username!</p>
                    </div>
                </aside>

                <!-- CENTER -->
                <section>
                    <h1 class="fd-page-title">@user.Username</h1>
                    <p class="fd-muted">@@@user.Username</p>

                    <div class="fd-profile-stats">
                        <div class="fd-stat-box"><span class="num">@recipes.Count()</span><span class="lbl">Receitas</span></div>
                        <div class="fd-stat-box"><span class="num">@string.Format("{0:0.0}", averageRating)</span><span class="lbl">Avaliação média</span></div>
                        <div class="fd-stat-box"><span class="num">@followerCount</span><span class="lbl">Seguidores</span></div>
                    </div>

                    <div class="fd-flex-between fd-mb-3">
                        <h3 style="font-family:var(--font-display);margin:0;font-size:20px">Publicações</h3>
                        <a href="@($"/myrecipes/{user.Id_User}")" class="fd-small">Ver todas →</a>
                    </div>

                    @foreach (var recipe in recipes.OrderByDescending(r => r.PublishedDate))
                    {
                        <a href="@($"/recipepage/{recipe.Id_Recipe}")" style="text-decoration:none;color:inherit;display:block" class="fd-card fd-mb-3">
                            <div class="fd-card-body">
                                <div class="fd-flex fd-mb-2">
                                    @if (!string.IsNullOrEmpty(user.UserPhoto))
                                    {
                                        <img src="@user.UserPhoto" class="fd-avatar fd-avatar--sm" style="object-fit:cover" />
                                    }
                                    else
                                    {
                                        <span class="fd-avatar fd-avatar--sm fd-avatar--a"></span>
                                    }
                                    <strong style="font-family:var(--font-display)">@user.Username</strong>
                                    <span class="fd-muted fd-small">· @recipe.PublishedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>

                                @if (recipe.Image != null)
                                {
                                    <img src="data:image/png;base64,@Convert.ToBase64String(recipe.Image)" alt="@recipe.NameRecipe"
                                         style="width:100%;height:220px;object-fit:cover;border-radius:var(--r-md);margin-bottom:10px" />
                                }
                                else
                                {
                                    <div class="fd-img fd-img--a" style="height:220px;border-radius:var(--r-md);margin-bottom:10px">
                                        <svg viewBox="0 0 200 140" width="50%"><g fill="none" stroke="currentColor" stroke-width="4"><circle cx="100" cy="80" r="40" fill="#fff"/></g></svg>
                                    </div>
                                }

                                <h4 style="font-family:var(--font-display);margin:0">@recipe.NameRecipe</h4>
                            </div>
                        </a>
                    }
                </section>

                <!-- RIGHT -->
                <aside class="fd-flex-col">
                    <div class="fd-side-card">
                        <h5>Grupos</h5>
                        @if (userGroups.Any())
                        {
                            <ul class="fd-h-list">
                                @foreach (var group in userGroups)
                                {
                                    <li>
                                        <i class="bi bi-house" style="color:#FF6B35"></i>
                                        <a href="@($"/grouppage/{group.Id_Group}")">@group.Name</a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="fd-muted fd-small" style="font-style:italic">Não pertence a nenhum grupo ainda.</p>
                        }
                    </div>

                    <div class="fd-side-card">
                        <h5>A seguir</h5>
                        @if (followedUsers.Any())
                        {
                            <ul class="fd-h-list">
                                @foreach (var followedUser in followedUsers)
                                {
                                    <li @onclick="() => NavigateToProfile(followedUser.Id_User)">
                                        @if (!string.IsNullOrEmpty(followedUser.UserPhoto))
                                        {
                                            <img src="@followedUser.UserPhoto" class="fd-avatar fd-avatar--xs" style="object-fit:cover" />
                                        }
                                        else
                                        {
                                            <span class="fd-avatar fd-avatar--xs fd-avatar--b"></span>
                                        }
                                        <span>@followedUser.Username</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="fd-muted fd-small" style="font-style:italic">Não está a seguir ninguém ainda.</p>
                        }
                    </div>
                </aside>

            </div>
        </div>
    </div>
}


@code {
    [Parameter] public int? userId { get; set; }

    private User? user;
    private bool isOwnProfile;
    private bool isFollowing = false;
    private User? currentUser;
    private int followerCount;

    private List<Recipe> recipes = new();
    private List<Posts> posts = new();
    private decimal averageRating = 0;

    private List<User> followedUsers = new();
    private List<Group> userGroups = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userEmail = authState.User.Identity?.Name;

        if (userId == null)
        {
            if (!string.IsNullOrEmpty(userEmail))
            {
                currentUser = await UserRepository.GetUserByEmail(userEmail);
                user = await UserRepository.GetUserByEmail(userEmail);
                followerCount = await UserRepository.GetFollowerCount(user.Id_User);
                isOwnProfile = true;
            }
        }
        else
        {
            user = await UserRepository.GetUserById(userId.Value);

            if (!string.IsNullOrEmpty(userEmail))
            {
                currentUser = await UserRepository.GetUserByEmail(userEmail);
                isOwnProfile = (user?.Id_User == currentUser?.Id_User);

                if (!isOwnProfile && user != null && currentUser != null)
                {
                    isFollowing = await UserRepository.IsFollowing(currentUser.Id_User, user.Id_User);
                }

                if (user != null)
            {
                    followerCount = await UserRepository.GetFollowerCount(user.Id_User);
            }
            }
        }

        if (user != null)
        {
            recipes = (await RecipeRepository.GetRecipesByUserId(user.Id_User)).ToList();
            posts = await PostRepository.GetPostsByUserId(user.Id_User);

            followedUsers = await UserRepository.GetFollowedUsers(user.Id_User);
            userGroups = await GroupRepository.GetUserGroups(user.Id_User);

            if (recipes.Any())
            {
                averageRating = recipes
                    .Where(r => r.AverageRating > 0)
                    .Select(r => r.AverageRating)
                    .DefaultIfEmpty(0)
                    .Average();
            }
        }
    }

    private async Task FollowUser()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userEmail = authState.User.Identity?.Name;

        if (!string.IsNullOrEmpty(userEmail))
        {
            if (currentUser != null && user != null)
            {
                bool success = await UserRepository.FollowUser(currentUser.Id_User, user.Id_User);

                if (success)
                {
                    isFollowing = true;
                }
            }
        }
    }

    private async Task UnfollowUser()
    {
        if (currentUser != null && user != null)
        {
            bool success = await UserRepository.UnfollowUser(currentUser.Id_User, user.Id_User);

            if (success)
            {
                isFollowing = false;
                StateHasChanged();
            }
        }
    }

    private void NavigateToProfile(int userId)
    {
        NavigationManager.NavigateTo($"/profilepage/{userId}", forceLoad: true);
    }

}
