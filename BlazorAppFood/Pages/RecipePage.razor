@page "/recipepage/{IdRecipe}"
@using BlazorAppFood.ComponentsFolder
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage

@inject IRecipeRepository RecipeRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject IChatRepository ChatRepository

<style>
    /* CSS auto-contido SÓ para esta página — classes rp-* não usadas em mais lado nenhum */

    .rp-wrap { padding: 32px 0 80px; font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif; }
    .rp-container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

    .rp-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        background: #fff;
        border: 1px solid #ECE6DB;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(28,24,22,.04), 0 4px 12px rgba(28,24,22,.05);
    }

    @@media (max-width: 900px) { .rp-grid { grid-template-columns: 1fr; } }

    .rp-grid > .rp-left,
    .rp-grid > .rp-right { padding: 24px; }
    .rp-grid > .rp-left { border-right: 1px solid #ECE6DB; }
    @@media (max-width: 900px) { .rp-grid > .rp-left { border-right: 0; border-bottom: 1px solid #ECE6DB; } }

    .rp-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }
    .rp-title-row h2 {
        margin: 0;
        font-family: "Poppins", system-ui, sans-serif;
        font-weight: 700;
        font-size: 24px;
        color: #1C1916;
    }

    .rp-bookmark {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 24px;
        color: #FF6B35;
        padding: 4px 8px;
    }

    .rp-hero {
        width: 100%;
        height: 220px;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        background: linear-gradient(135deg, #FFE7D2, #FFF3B0);
    }
    .rp-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .rp-section-h {
        font-family: "Poppins", system-ui, sans-serif;
        font-size: 15px;
        font-weight: 700;
        margin: 18px 0 8px;
        color: #1C1916;
    }

    .rp-ingredients { list-style: none; padding: 0; margin: 0; }
    .rp-ingredients li {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 0;
        border-bottom: 1px dashed #ECE6DB;
        font-size: 14px;
    }
    .rp-ingredients li::before { content: "•"; color: #FF6B35; font-weight: 700; }

    .rp-prep {
        font-size: 14.5px;
        color: #76706A;
        white-space: pre-wrap;
        margin: 0 0 14px;
    }

    .rp-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        color: #76706A;
        font-size: 13.5px;
        margin: 8px 0;
    }
    .rp-meta-row strong { color: #1C1916; font-family: "Poppins", system-ui, sans-serif; font-weight: 600; }

    .rp-badge {
        display: inline-block;
        font-family: "Poppins", system-ui, sans-serif;
        font-weight: 600;
        font-size: 11.5px;
        padding: 4px 10px;
        border-radius: 999px;
    }
    .rp-badge-success { background: #E5F4E9; color: #2D7A40; }
    .rp-badge-warning { background: #FFF1C7; color: #8A6B14; }
    .rp-badge-danger  { background: #FBEAEC; color: #8A1F2A; }

    .rp-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
    .rp-tag-pill {
        display: inline-flex;
        align-items: center;
        font-family: "Poppins", system-ui, sans-serif;
        font-weight: 600;
        font-size: 12px;
        padding: 5px 11px;
        border-radius: 999px;
        background: #DCE7F4;
        color: #3D7DC3;
        border: 1px solid #C1D6ED;
        text-decoration: none;
    }
    .rp-tag-pill:hover { background: #CBDEEF; text-decoration: none; }

    .rp-author-row { display: flex; gap: 12px; align-items: center; margin-bottom: 16px; }

    .rp-avatar-md {
        width: 48px !important;
        height: 48px !important;
        border-radius: 50% !important;
        object-fit: cover !important;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #ECE6DB;
        display: inline-block;
    }
    .rp-avatar-fb-md {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FF6B35, #FFC857);
        display: inline-block;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #ECE6DB;
    }
    .rp-avatar-xs {
        width: 28px !important;
        height: 28px !important;
        border-radius: 50% !important;
        object-fit: cover !important;
        border: 1.5px solid #fff;
        flex-shrink: 0;
    }
    .rp-avatar-fb-xs {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FF6B35, #FFC857);
        display: inline-block;
        border: 1.5px solid #fff;
        flex-shrink: 0;
    }

    .rp-author-name {
        font-family: "Poppins", system-ui, sans-serif;
        font-weight: 700;
        color: #1C1916;
        text-decoration: none;
        cursor: pointer;
    }

    .rp-muted { color: #76706A; }
    .rp-small { font-size: 12.5px; }

    .rp-side-card {
        background: #fff;
        border: 1px solid #ECE6DB;
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 18px;
    }

    .rp-chat {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 14px;
        max-height: 360px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .rp-bubble { display: flex; gap: 10px; align-items: flex-start; }
    .rp-bubble--me { flex-direction: row-reverse; }

    .rp-bubble-body {
        background: #F6F2EC;
        border-radius: 14px;
        padding: 10px 14px;
        max-width: 80%;
        font-size: 13.5px;
    }
    .rp-bubble--me .rp-bubble-body { background: #E3F4E8; }
    .rp-bubble--author .rp-bubble-body { background: #DCE7F4; }

    .rp-bubble-body strong {
        display: block;
        font-family: "Poppins", system-ui, sans-serif;
        font-size: 13px;
        margin-bottom: 2px;
    }
    .rp-bubble-body time {
        display: block;
        font-size: 11px;
        color: #76706A;
        margin-top: 4px;
    }

    .rp-chat-input {
        display: flex;
        gap: 8px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid #ECE6DB;
    }
    .rp-chat-input input {
        flex: 1;
        background: #fff;
        border: 1px solid #DDD5C5;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 14.5px;
        color: #1C1916;
        font-family: inherit;
    }
    .rp-chat-input input:focus {
        outline: none;
        border-color: #FF6B35;
        box-shadow: 0 0 0 4px rgba(255,107,53,.12);
    }
    .rp-chat-input button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #FF6B35;
        color: #fff;
        border: 1px solid #FF6B35;
        border-radius: 999px;
        padding: 10px 18px;
        cursor: pointer;
        box-shadow: 0 6px 14px rgba(255,107,53,.25);
    }
    .rp-chat-input button:hover { background: #E55524; border-color: #E55524; }
</style>

<AuthorizeView>
    <Authorized>

        <main class="rp-wrap">
            <div class="rp-container">
                <div class="rp-grid">

                    <!-- ============ LEFT PANEL ============ -->
                    <div class="rp-left">

                        <div class="rp-title-row">
                            <h2>@recipe.NameRecipe</h2>
                            <button class="rp-bookmark" @onclick="AddFavorite" aria-label="Favoritar">
                                @if (isFavorite)
                                {
                                    <i class="bi bi-bookmark-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bookmark"></i>
                                }
                            </button>
                        </div>

                        @if (recipe.Image != null)
                        {
                            var img = $"data:image/jpeg;base64,{Convert.ToBase64String(recipe.Image)}";
                            <div class="rp-hero">
                                <img src="@img" alt="@recipe.NameRecipe" />
                            </div>
                        }
                        else
                        {
                            <div class="rp-hero">
                                <i class="bi bi-egg-fried" style="font-size:48px; opacity:.4; color:#C56A2B"></i>
                            </div>
                        }

                        @if (recipe.Ingredients?.Count > 0)
                        {
                            <h5 class="rp-section-h">Ingredientes</h5>
                            <ul class="rp-ingredients">
                                @foreach (var ing in recipe.Ingredients)
                                {
                                    <li>@ing.Name</li>
                                }
                            </ul>
                        }

                        <h5 class="rp-section-h">Preparação</h5>
                        <p class="rp-prep">@recipe.Preparation</p>

                        <div class="rp-meta-row">
                            @if (recipe.Servings > 0)
                            {
                                <span><strong>Rendimento:</strong> @recipe.Servings porções</span>
                            }
                            <span>
                                <strong>Dificuldade:</strong>
                                <span class="rp-badge @GetDifficultyBadge(recipe.Difficulty)">
                                    @(recipe.Difficulty switch
                                    {
                                        DifficultyLevel.Facil => "Fácil",
                                        DifficultyLevel.Medio => "Médio",
                                        DifficultyLevel.Dificil => "Difícil",
                                        _ => "Fácil"
                                    })
                                </span>
                            </span>
                        </div>

                        <div class="rp-meta-row">
                            <span><strong>Tempo de preparação:</strong> @TimeFormatter.FormatMinutes(recipe.Prep_Time)</span>
                            <span><strong>Tempo de cozinhar:</strong> @TimeFormatter.FormatMinutes(recipe.Cook_Time)</span>
                        </div>

                        @if (recipe.Tags?.Count > 0)
                        {
                            <div class="rp-tags">
                                @foreach (var tag in recipe.Tags)
                                {
                                    <a href="/feed/@tag.IdTag" class="rp-tag-pill">#@tag.NameTag</a>
                                }
                            </div>
                        }
                    </div>

                    <!-- ============ RIGHT PANEL ============ -->
                    <div class="rp-right">

                        <div class="rp-author-row">
                            @if (!string.IsNullOrEmpty(recipe.UserPhoto))
                            {
                                <img src="@recipe.UserPhoto" class="rp-avatar-md"
                                     style="cursor:pointer"
                                     @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + recipe.Id_User))" />
                            }
                            else
                            {
                                <span class="rp-avatar-fb-md"
                                      style="cursor:pointer"
                                      @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + recipe.Id_User))"></span>
                            }
                            <div>
                                <a class="rp-author-name"
                                   @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + recipe.Id_User))">
                                    @recipe.Username
                                </a>
                                <div class="rp-muted rp-small">
                                    @recipe.PublishedDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>

                        <div class="rp-side-card">
                            <p class="rp-small rp-muted" style="margin:0 0 6px">
                                Experimentaste esta receita? Avalia →
                            </p>
                            <Rating idRecipe="@recipe.Id_Recipe" idUser="@user.Id_User"></Rating>
                        </div>

                        <h5 class="rp-section-h" style="margin:0 0 8px">Comentários</h5>

                        <div class="rp-chat">
                            @if (recipe.Comments != null && recipe.Comments.Any())
                            {
                                @foreach (var comment in recipe.Comments)
                                {
                                    bool isUserComment = comment.IdUser == user.Id_User;
                                    bool isAuthorComment = comment.IdUser == recipe.Id_User;
                                    string bubbleClass = isUserComment
                                        ? "rp-bubble rp-bubble--me"
                                        : isAuthorComment
                                            ? "rp-bubble rp-bubble--author"
                                            : "rp-bubble";

                                    <div class="@bubbleClass">
                                        @if (isUserComment)
                                        {
                                            @if (!string.IsNullOrEmpty(user.UserPhoto))
                                            {
                                                <img src="@user.UserPhoto" class="rp-avatar-xs" />
                                            }
                                            else
                                            {
                                                <span class="rp-avatar-fb-xs"></span>
                                            }
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrEmpty(comment.UserPhoto))
                                            {
                                                <img src="@comment.UserPhoto" class="rp-avatar-xs"
                                                     style="cursor:pointer"
                                                     @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + comment.IdUser))" />
                                            }
                                            else
                                            {
                                                <span class="rp-avatar-fb-xs"
                                                      style="cursor:pointer"
                                                      @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + comment.IdUser))"></span>
                                            }
                                        }
                                        <div class="rp-bubble-body">
                                            <strong>
                                                @if (isUserComment)
                                                {
                                                    @("Eu")
                                                }
                                                else
                                                {
                                                    @comment.UserName
                                                }
                                            </strong>
                                            @comment.Message
                                            <time>@comment.PublishedDate.ToString("dd/MM/yyyy HH:mm")</time>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="rp-muted rp-small" style="text-align:center; padding:20px 0">
                                    Ainda sem comentários. Sê o primeiro!
                                </p>
                            }
                        </div>

                        <div class="rp-chat-input">
                            <input type="text"
                                   @onkeydown="@Enter" @bind="newMessage"
                                   placeholder="Escreve um comentário..." />
                            <button type="button" @onclick="@CreateComment" aria-label="Enviar">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </main>

    </Authorized>
    <NotAuthorized>
        <div class="rp-wrap" style="text-align:center; padding:60px">
            <h3>Sessão terminada</h3>
            <p class="rp-muted">Não tens permissão para ver esta página.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string IdRecipe { get; set; }

    public User user = new User();
    public Recipe recipe = new Recipe();
    public string newMessage = "";

    bool isFavorite = false;

    private string GetDifficultyBadge(DifficultyLevel level) => level switch
    {
        DifficultyLevel.Facil => "rp-badge-success",
        DifficultyLevel.Medio => "rp-badge-warning",
        DifficultyLevel.Dificil => "rp-badge-danger",
        _ => "rp-badge-success"
    };

    protected override async Task OnParametersSetAsync()
    {
        string emailUser = await sessionStorage.GetItemAsync<string>("userEmail");

        if (emailUser != null)
        {
            user = await UserRepository.GetUserInfo(emailUser);
            recipe = await RecipeRepository.GetRecipeInfo(Convert.ToInt32(IdRecipe));
            recipe.Comments = await ChatRepository.LoadRecipeComments(recipe.Id_Recipe);

            // Buscar info do utilizador por cada comentário
            foreach (var comment in recipe.Comments)
            {
                var commentUser = await UserRepository.GetUserById(comment.IdUser);
                comment.UserName = commentUser?.Username;
                comment.UserPhoto = commentUser?.UserPhoto;
            }

            isFavorite = await RecipeRepository.CheckFavorite(recipe.Id_Recipe, user.Id_User);
        }
    }

    public async Task Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            await CreateComment();
        }
    }

    public async Task CreateComment()
    {
        if (!string.IsNullOrWhiteSpace(newMessage))
        {
            await ChatRepository.CreateComment(recipe.Id_Recipe, user.Id_User, newMessage);
            recipe.Comments = await ChatRepository.LoadRecipeComments(recipe.Id_Recipe);

            // Atualizar dados dos utilizadores novamente
            foreach (var comment in recipe.Comments)
            {
                var commentUser = await UserRepository.GetUserById(comment.IdUser);
                comment.UserName = commentUser?.Username;
                comment.UserPhoto = commentUser?.UserPhoto;
            }

            newMessage = string.Empty;
        }
    }

    public async Task AddFavorite()
    {
        await RecipeRepository.AddFavorite(recipe.Id_Recipe, user.Id_User);

        isFavorite = await RecipeRepository.CheckFavorite(recipe.Id_Recipe, user.Id_User);

        StateHasChanged();
    }
}
