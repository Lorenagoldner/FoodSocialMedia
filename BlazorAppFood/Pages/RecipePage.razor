@page "/recipepage/{IdRecipe}"
@using BlazorAppFood.ComponentsFolder
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage

@inject IRecipeRepository RecipeRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject IChatRepository ChatRepository

<style>
    .bg-lightgreen {
        background-color: #d4edda !important; /* Verde claro */
    }

    .bg-lightblue {
        background-color: #d1ecf1 !important; /* Azul claro */
    }

    .bg-light {
        background-color: #f8f9fa !important; /* Cinza claro */
    }
</style>
<AuthorizeView>
    <Authorized>

        <div class="container">
            <div class="card card-recipe">
                <div class="card-recipe-header row d-flex align-items-center">
                    <div class="col-10">
                        <h3>@recipe.NameRecipe</h3>
                    </div>
                    <div class="col">
                        @* <button color="red" Primary="false" @onclick="AddFavorite"><i class="bi bi-bookmark"></i></button> *@
                        <button @onclick="AddFavorite" class="btn btn-link">
                            @if (isFavorite)
                            {
                                <i class="bi bi-bookmark-fill"></i> @* Filled Bookmark if favorited *@
                            }
                            else
                            {
                                <i class="bi bi-bookmark"></i> @* Outline Bookmark if not favorited *@
                            }
                        </button>
                    </div>
                </div>

                <div class="row">
                    <div class="card-recipe-panel-left col-6">
                        @if (recipe.Image != null)
                        {
                            var img = $"data:image/jpeg;base64,{Convert.ToBase64String(recipe.Image)}";
                            <img src="@img" style="width: 100%; height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="img/images.svg" alt="">
                        }

                        <br />
                        @if (recipe.Ingredients?.Count > 0)
                        {
                            <div class="mt-3">
                                <h5>Ingredientes:</h5>
                                <ul>
                                    @foreach (var ing in recipe.Ingredients)
                                    {
                                        <li>@ing.Name</li>
                                    }
                                </ul>
                            </div>
                        }
                        <p><b>Preparação:</b> @recipe.Preparation</p>
                        @if (recipe.Servings > 0)
                        {
                            <p><b>Rendimento:</b> @recipe.Servings porções</p>
                        }
                        <p><b>Dificuldade:</b>
                            @(recipe.Difficulty switch {
                                DifficultyLevel.Facil => "Fácil",
                                DifficultyLevel.Medio => "Médio",
                                DifficultyLevel.Dificil => "Difícil",
                                _ => "Fácil"
                            })
                        </p>
                        <p><b>Tempo de Preparação:</b> @TimeFormatter.FormatMinutes(recipe.Prep_Time)</p>
                        <p><b>Tempo de Cozinhar:</b> @TimeFormatter.FormatMinutes(recipe.Cook_Time)</p>
                        @if (recipe.Tags?.Count > 0)
                        {
                            <div class="mt-3">
                                <h5>Tags:</h5>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var tag in recipe.Tags)
                                    {
                                        <a class="badge bg-primary rounded-pill px-3 py-2 text-decoration-none text-white"
                                           href="/feed/@tag.IdTag">
                                            @tag.NameTag
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-recipe-panel-right col-6">
                        <div class="card-recipe-user-info row d-flex align-items-center">
                            <div class="col-2">
                                @if (recipe.UserPhoto != null)
                                {
                                    <img src="@recipe.UserPhoto" alt="" class="rounded-circle" width="55" height="55" style="cursor: pointer;" @onclick=@(() => NavigationManager.NavigateTo("/profilepage/" + recipe.Id_User))>
                                }
                                else
                                {
                                    <img src="img/avatar2.jpg" alt="" class="rounded-circle" width="55" height="55">
                                }
                            </div>
                            <div class="col" style="cursor: pointer; color: black;" 
                                    onmouseover="this.style.color='blue';" 
                                    onmouseout="this.style.color='black';" 
                                    @onclick=@(() => NavigationManager.NavigateTo("/profilepage/" + recipe.Id_User))>
                                <h6>@recipe.Username</h6>
                                <small class="text-muted">
                                    @recipe.PublishedDate.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        </div>

                        <div class="card-recipe-user-rating row">
                            <div class="col-4">
                                <h6>Experimentou esta receita?</h6>
                                <strong>Avalie -></strong>
                            </div>
                            <div class="col d-flex justify-content-center">
                                <Rating idRecipe="@recipe.Id_Recipe" idUser="@user.Id_User"></Rating>
                            </div>
                        </div>

                        <div class="recipe-card-comments">
                            <div class="comments-area">
                                @if (recipe.Comments != null)
                                {
                                    @foreach (var comment in recipe.Comments)
                                    {
                                        bool isUserComment = comment.IdUser == user.Id_User;
                                        bool isAuthorComment = comment.IdUser == recipe.Id_User;

                                        string alignmentClass = isUserComment ? "text-end ms-auto bg-lightgreen"
                                        : isAuthorComment ? "text-start me-auto bg-lightblue"
                                        : "text-start me-auto bg-light";

                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <div class="d-flex flex-column p-2 rounded shadow-sm @alignmentClass" style="max-width: 75%;">
                                                    <div class="d-flex align-items-center mb-1">
                                                        @if (!string.IsNullOrEmpty(comment.UserPhoto))
                                                        {
                                                            <img src="@comment.UserPhoto" alt=""
                                                                 class="rounded-circle me-2" width="35" height="35"
                                                                 style="cursor: pointer;"
                                                                 @onclick=@(() => NavigationManager.NavigateTo("/profilepage/" + comment.IdUser))>
                                                        }
                                                        else
                                                        {
                                                            <img src="img/avatar2.jpg" alt=""
                                                                 class="rounded-circle me-2" width="35" height="35">
                                                        }
                                                        <strong style="cursor: pointer; color: black;"
                                                                onmouseover="this.style.color='blue';"
                                                                onmouseout="this.style.color='black';"
                                                                @onclick=@(() => NavigationManager.NavigateTo("/profilepage/" + comment.IdUser))>
                                                            @comment.UserName
                                                        </strong>
                                                    </div>
                                                    <div>
                                                        <span>@comment.Message</span><br />
                                                        <small class="text-muted">@comment.PublishedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }



                                    
                                
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="mb-3">
                                        @*<textarea @onkeydown="@Enter" @bind="newMessage" class="form-control" id="textAreaPreparation" rows="1" placeholder="New comment..."></textarea>*@
                                        <input type="text" @onkeydown="@Enter" @bind="newMessage" class="form-control" id="inputComment" placeholder="Novo comentário..." />
                                    </div>
                                </div>
                                <div class="col-2 d-flex align-items-center">
                                    <span @onclick="@CreateComment" style="cursor: pointer;"><i class="bi bi-chat-dots"></i></span>
                                </div>
                            </div>
                        </div>

                        @*<div class="row">
                            <form @onsubmit=Enter>
                                <label for="todo">What to do?</label>
                                <input id="todo" placeholder="Something todo" @bind="newTodo" />
                                <button>Add todo</button>
                            </form>
                            <ul>
                                @foreach (var item in todos)
                                {
                                    <li @key=item>@item.Title</li>
                                }
                            </ul>
                        </div>*@
                    </div>
                </div>
            </div>
        </div>

    </Authorized>
    <NotAuthorized>
        <h3>You are logged out</h3>
        <p>You are not authorized to view this page.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string IdRecipe { get; set; }

    public User user = new User();
    public Recipe recipe = new Recipe();
    public string newMessage = "";

    bool isFavorite = false;

    protected override async Task OnParametersSetAsync()
    {
        string emailUser = await sessionStorage.GetItemAsync<string>("userEmail");

        if (emailUser != null)
        {
            user = await UserRepository.GetUserInfo(emailUser);
            recipe = await RecipeRepository.GetRecipeInfo(Convert.ToInt32(IdRecipe));
            recipe.Comments = await ChatRepository.LoadRecipeComments(recipe.Id_Recipe);

            // Buscar info do utilizador por cada comentário
            foreach (var comment in recipe.Comments)
            {
                var commentUser = await UserRepository.GetUserById(comment.IdUser);
                comment.UserName = commentUser?.Username;
                comment.UserPhoto = commentUser?.UserPhoto;
            }

            isFavorite = await RecipeRepository.CheckFavorite(recipe.Id_Recipe, user.Id_User);
        }
    }

    public async Task Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            await CreateComment();
        }
    }

    public async Task CreateComment()
    {
        if (!string.IsNullOrWhiteSpace(newMessage))
        {
            await ChatRepository.CreateComment(recipe.Id_Recipe, user.Id_User, newMessage);
            recipe.Comments = await ChatRepository.LoadRecipeComments(recipe.Id_Recipe);

            // Atualizar dados dos utilizadores novamente
            foreach (var comment in recipe.Comments)
            {
                var commentUser = await UserRepository.GetUserById(comment.IdUser);
                comment.UserName = commentUser?.Username;
                comment.UserPhoto = commentUser?.UserPhoto;
            }

            newMessage = string.Empty;
        }
    }

    public async Task AddFavorite()
    {
        await RecipeRepository.AddFavorite(recipe.Id_Recipe, user.Id_User);

        isFavorite = await RecipeRepository.CheckFavorite(recipe.Id_Recipe, user.Id_User);

        StateHasChanged();
    }
}
