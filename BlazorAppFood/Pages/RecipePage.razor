@page "/recipepage/{IdRecipe}"
@using BlazorAppFood.ComponentsFolder
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage

@inject IRecipeRepository RecipeRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject IChatRepository ChatRepository

<AuthorizeView>
    <Authorized>

        <main class="page">
            <div class="container">
                <div class="fd-recipe-detail">

                    <!-- ============ LEFT PANEL ============ -->
                    <div class="fd-recipe-detail__left">

                        <div class="flex-between mb-2">
                            <h2 style="margin:0">@recipe.NameRecipe</h2>
                            <button class="bookmark-btn" @onclick="AddFavorite" aria-label="Favoritar"
                                    style="background:none;border:none;cursor:pointer;font-size:24px">
                                @if (isFavorite)
                                {
                                    <i class="bi bi-bookmark-fill" style="color:#FF6B35"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bookmark" style="color:#FF6B35"></i>
                                }
                            </button>
                        </div>

                        @if (recipe.Image != null)
                        {
                            var img = $"data:image/jpeg;base64,{Convert.ToBase64String(recipe.Image)}";
                            <div class="fd-recipe-hero" style="overflow:hidden">
                                <img src="@img" alt="@recipe.NameRecipe"
                                     style="width:100%; height:100%; object-fit:cover; border-radius:inherit" />
                            </div>
                        }
                        else
                        {
                            <div class="fd-recipe-hero fd-img fd-img--a">
                                <i class="bi bi-egg-fried" style="font-size:48px; opacity:.4"></i>
                            </div>
                        }

                        @if (recipe.Ingredients?.Count > 0)
                        {
                            <h5 style="font-family:var(--font-display); font-size:15px; margin:18px 0 8px">
                                Ingredientes
                            </h5>
                            <ul class="fd-ingredients">
                                @foreach (var ing in recipe.Ingredients)
                                {
                                    <li>@ing.Name</li>
                                }
                            </ul>
                        }

                        <h5 style="font-family:var(--font-display); font-size:15px; margin:18px 0 8px">
                            Preparação
                        </h5>
                        <p class="muted" style="font-size:14.5px; white-space:pre-wrap">@recipe.Preparation</p>

                        <div class="fd-meta-row">
                            @if (recipe.Servings > 0)
                            {
                                <span><strong>Rendimento:</strong> @recipe.Servings porções</span>
                            }
                            <span>
                                <strong>Dificuldade:</strong>
                                <span class="badge @GetDifficultyBadge(recipe.Difficulty)">
                                    @(recipe.Difficulty switch
                                    {
                                        DifficultyLevel.Facil => "Fácil",
                                        DifficultyLevel.Medio => "Médio",
                                        DifficultyLevel.Dificil => "Difícil",
                                        _ => "Fácil"
                                    })
                                </span>
                            </span>
                        </div>

                        <div class="fd-meta-row">
                            <span><strong>Tempo de preparação:</strong> @TimeFormatter.FormatMinutes(recipe.Prep_Time)</span>
                            <span><strong>Tempo de cozinhar:</strong> @TimeFormatter.FormatMinutes(recipe.Cook_Time)</span>
                        </div>

                        @if (recipe.Tags?.Count > 0)
                        {
                            <div class="flex" style="flex-wrap:wrap; gap:6px; margin-top:14px">
                                @foreach (var tag in recipe.Tags)
                                {
                                    <a href="/feed/@tag.IdTag" class="tag-pill">#@tag.NameTag</a>
                                }
                            </div>
                        }
                    </div>

                    <!-- ============ RIGHT PANEL ============ -->
                    <div class="fd-recipe-detail__right">

                        <div class="flex mb-3" style="gap:12px; align-items:center">
                            @if (!string.IsNullOrEmpty(recipe.UserPhoto))
                            {
                                <a @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + recipe.Id_User))"
                                   style="cursor:pointer">
                                    <img src="@recipe.UserPhoto" class="fd-avatar fd-avatar--md"
                                         style="object-fit:cover" />
                                </a>
                            }
                            else
                            {
                                <span class="fd-avatar fd-avatar--md fd-avatar--a"></span>
                            }
                            <div>
                                <a @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + recipe.Id_User))"
                                   style="font-family:var(--font-display); font-weight:700; color:var(--ink); cursor:pointer; text-decoration:none">
                                    @recipe.Username
                                </a>
                                <div class="muted small">
                                    @recipe.PublishedDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>

                        <div class="fd-side-card" style="margin-bottom:18px">
                            <p class="small muted" style="margin:0 0 6px">
                                Experimentaste esta receita? Avalia →
                            </p>
                            <Rating idRecipe="@recipe.Id_Recipe" idUser="@user.Id_User"></Rating>
                        </div>

                        <h5 style="font-family:var(--font-display); font-size:15px; margin:0 0 8px">
                            Comentários
                        </h5>

                        <div class="fd-chat">
                            @if (recipe.Comments != null && recipe.Comments.Any())
                            {
                                @foreach (var comment in recipe.Comments)
                                {
                                    bool isUserComment = comment.IdUser == user.Id_User;
                                    bool isAuthorComment = comment.IdUser == recipe.Id_User;
                                    string bubbleClass = isUserComment
                                        ? "fd-bubble fd-bubble--me"
                                        : isAuthorComment
                                            ? "fd-bubble fd-bubble--author"
                                            : "fd-bubble";

                                    <div class="@bubbleClass">
                                        @if (!isUserComment)
                                        {
                                            @if (!string.IsNullOrEmpty(comment.UserPhoto))
                                            {
                                                <a @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + comment.IdUser))"
                                                   style="cursor:pointer">
                                                    <img src="@comment.UserPhoto" class="fd-avatar fd-avatar--xs"
                                                         style="object-fit:cover" />
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="fd-avatar fd-avatar--xs fd-avatar--a"></span>
                                            }
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrEmpty(user.UserPhoto))
                                            {
                                                <img src="@user.UserPhoto" class="fd-avatar fd-avatar--xs"
                                                     style="object-fit:cover" />
                                            }
                                            else
                                            {
                                                <span class="fd-avatar fd-avatar--xs fd-avatar--c"></span>
                                            }
                                        }
                                        <div class="fd-bubble__body">
                                            <strong>
                                                @if (isUserComment)
                                                {
                                                    @("Eu")
                                                }
                                                else
                                                {
                                                    @comment.UserName
                                                }
                                            </strong>
                                            @comment.Message
                                            <time>@comment.PublishedDate.ToString("dd/MM/yyyy HH:mm")</time>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="muted small" style="text-align:center; padding:20px 0">
                                    Ainda sem comentários. Sê o primeiro!
                                </p>
                            }
                        </div>

                        <div class="fd-chat-input">
                            <input class="form-control" type="text"
                                   @onkeydown="@Enter" @bind="newMessage"
                                   placeholder="Escreve um comentário..." />
                            <button class="btn btn-primary" type="button" @onclick="@CreateComment"
                                    aria-label="Enviar">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </main>

    </Authorized>
    <NotAuthorized>
        <div class="page" style="text-align:center; padding:60px">
            <h3>Sessão terminada</h3>
            <p class="muted">Não tens permissão para ver esta página.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string IdRecipe { get; set; }

    public User user = new User();
    public Recipe recipe = new Recipe();
    public string newMessage = "";

    bool isFavorite = false;

    private string GetDifficultyBadge(DifficultyLevel level) => level switch
    {
        DifficultyLevel.Facil => "badge-success",
        DifficultyLevel.Medio => "badge-warning",
        DifficultyLevel.Dificil => "badge-danger",
        _ => "badge-success"
    };

    protected override async Task OnParametersSetAsync()
    {
        string emailUser = await sessionStorage.GetItemAsync<string>("userEmail");

        if (emailUser != null)
        {
            user = await UserRepository.GetUserInfo(emailUser);
            recipe = await RecipeRepository.GetRecipeInfo(Convert.ToInt32(IdRecipe));

            // OTIMIZAÇÃO: LoadRecipeComments já faz JOIN com Users e traz
            // Username + UserPhoto numa só query. Removemos o foreach + GetUserById
            // que era N+1 (1 query por comentário).
            recipe.Comments = await ChatRepository.LoadRecipeComments(recipe.Id_Recipe);

            isFavorite = await RecipeRepository.CheckFavorite(recipe.Id_Recipe, user.Id_User);
        }
    }

    public async Task Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            await CreateComment();
        }
    }

    public async Task CreateComment()
    {
        if (!string.IsNullOrWhiteSpace(newMessage))
        {
            await ChatRepository.CreateComment(recipe.Id_Recipe, user.Id_User, newMessage);

            // OTIMIZAÇÃO: LoadRecipeComments já popula UserName + UserPhoto.
            // Removemos o foreach + GetUserById (eliminação do N+1).
            recipe.Comments = await ChatRepository.LoadRecipeComments(recipe.Id_Recipe);

            newMessage = string.Empty;
        }
    }

    public async Task AddFavorite()
    {
        await RecipeRepository.AddFavorite(recipe.Id_Recipe, user.Id_User);
        isFavorite = await RecipeRepository.CheckFavorite(recipe.Id_Recipe, user.Id_User);
        StateHasChanged();
    }
}
