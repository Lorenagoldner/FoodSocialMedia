@page "/userpage"
@using BlazorAppFood.Models
@using BlazorAppFood.Data
@using Blazored.SessionStorage
@using BlazorAppFood.ComponentsFolder

@inject IRecipeService RecipeService
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject ISessionStorageService sessionStorage
@inject IChatService ChatService
@inject IGroupService GroupService

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />

<style>
    .settings-container {
        display: flex;
        font-family: 'Segoe UI', sans-serif;
        padding: 2rem;
        gap: 2rem;
    }

    .btn {
        color: white;
        padding: 0.25rem 1rem; /* py-1 px-4 */
        border-radius: 0.5rem; /* rounded-lg */
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .btn-yellow {
        background-color: #facc15; /* bg-yellow-500 */
    }

        .btn-yellow:hover {
            background-color: #eab308; /* hover:bg-yellow-600 */
        }

    .btn-red {
        background-color: #ef4444; /* bg-red-500 */
    }

        .btn-red:hover {
            background-color: #dc2626; /* hover:bg-red-600 */
        }

    .sidebar {
        width: 200px;
        border-right: 1px solid #ddd;
        padding-right: 1rem;
    }

        .sidebar h2 {
            font-size: 1.4rem;
            margin-bottom: 1rem;
        }

        .sidebar ul {
            list-style: none;
            padding-left: 0;
        }

        .sidebar li {
            margin-bottom: 1rem;
        }

    .main-content {
        flex: 1;
        display: flex;
        justify-content: center;
    }

    .profile-form {
        width: 100%;
        max-width: 500px;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .profile-photo-section {
        text-align: center;
    }

    .profile-photo {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 0.5rem;
    }

    .form-group label {
        font-weight: bold;
        margin-bottom: 0.3rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-control[disabled] {
        background-color: #f2f2f2;
    }

    .save-btn {
        background-color: #e53935;
        color: white;
        border: none;
        padding: 0.7rem;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

    .edit-btn {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 0.7rem;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

    .sidebar-link {
        color: black;
        background: none;
        border: none;
        padding: 0;
        text-align: start;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.2s;
    }

        .sidebar-link:hover {
            color: #2563eb; /* azul tipo blue-600 */
            text-decoration: underline;
        }

    .btn-gray {
        background-color: #d1d5db; /* gray-300 */
        color: black;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        border: none;
        cursor: pointer;
    }

    .btn-blue {
        background-color: #2563eb; /* blue-600 */
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        border: none;
        cursor: pointer;
    }

    .btn-red {
        background-color: #dc2626; /* red-600 */
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        border: none;
        cursor: pointer;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background-color: white;
        padding: 2rem;
        border-radius: 0.5rem;
        max-width: 500px;
        width: 100%;
        z-index: 1001;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .group-card {
        display: flex;
        background-color: white;
        border-radius: 0.75rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .group-card-left {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f3f4f6; /* cinza claro */
        padding: 1rem;
        min-width: 120px;
    }

    .group-card-body {
        padding: 1rem;
        flex: 1;
    }

    .group-title {
        font-size: 1.25rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .btn-group {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
    }

</style>

<AuthorizeView>
    <Authorized>
        <div class="settings-container">
            <div class="sidebar">
                <div class="user-summary text-center mb-3">
                    <img src="@(!string.IsNullOrWhiteSpace(user.UserPhoto) ? user.UserPhoto : "https://via.placeholder.com/100")"
                         class="profile-photo" />
                    <p class="mt-2"><strong>@user.Username</strong></p>
                </div>
                <h2>Definições</h2>
                <ul>
                    <li>
                        <button class="sidebar-link" @onclick='() => SetSection("perfil")'>
                            Editar Perfil
                        </button>
                    </li>
                    <li>
                        <button class="sidebar-link" @onclick='() => SetSection("grupos")'>
                            Meus Grupos
                        </button>
                    </li>
                </ul>
            </div>

            <div class="main-content">
                @if (currentSection == "perfil")
                {
                    <div class="profile-form">
                        <div class="profile-photo-section">
                            <img src="@user.UserPhoto" class="profile-photo" />
                        </div>
                        <div class="form-group mt-2">
                            <label>Adicionar/Alterar Foto</label>
                            <InputFile OnChange="HandleSelectedPhoto" />
                        </div>

                        @if (isEditing)
                        {
                            <div class="form-group">
                                <label><i class="bi bi-person"></i> Nome</label>
                                @if (isEditingName)
                                {
                                    <input class="form-control" @bind="user.Username" />
                                    <button class="save-btn mt-1" @onclick="SaveName">Guardar</button>
                                }
                                else
                                {
                                    <input class="form-control" value="@user.Username" disabled />
                                    <button class="edit-btn mt-1" @onclick="@(() => isEditingName = true)">Editar</button>
                                }
                            </div>

                            <div class="form-group">
                                <label><i class="bi bi-envelope"></i> Email</label>
                                @if (isEditingEmail)
                                {
                                    <input class="form-control" @bind="user.Email" />
                                    <button class="save-btn mt-1" @onclick="SaveEmail">Guardar</button>
                                }
                                else
                                {
                                    <input class="form-control" value="@user.Email" disabled />
                                    <button class="edit-btn mt-1" @onclick="@(() => isEditingEmail = true)">Editar</button>
                                }
                            </div>

                            <div class="form-group">
                                <label><i class="bi bi-lock"></i> Nova Password</label>
                                @if (isEditingPassword)
                                {
                                    <div class="input-group">
                                        <input type="@((isPasswordVisible ? "text" : "password"))" class="form-control" @bind="newPassword" />
                                        <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility">
                                            @if (isPasswordVisible)
                                            {
                                                <i class="bi bi-eye-slash"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-eye"></i>
                                            }
                                        </button>
                                        <button class="save-btn mt-1" @onclick="SavePassword">Guardar</button>
                                    </div>
                                }
                                else
                                {
                                    <input type="password" class="form-control" value="********" disabled />
                                    <button class="edit-btn mt-1" @onclick="@(() => isEditingPassword = true)">Editar</button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label><i class="bi bi-person"></i> Nome</label>
                                <input class="form-control" value="@user.Username" disabled />
                            </div>

                            <div class="form-group">
                                <label><i class="bi bi-envelope"></i> Email</label>
                                <input class="form-control" value="@user.Email" disabled />
                            </div>

                            <div class="form-group">
                                <label><i class="bi bi-lock"></i> Senha</label>
                                <input type="password" class="form-control" value="********" disabled />
                            </div>

                            <button class="edit-btn" @onclick="ToggleEditMode">Editar</button>
                        }
                    </div>
                }
                else if (currentSection == "grupos")
                {
                    <div class="meus-grupos space-y-4">
                        <h3 class="text-2xl font-semibold mb-4">Grupos Criados</h3>
                        <div class="text-center my-4">
                            <button class="btn btn-blue" @onclick="@(() => NavigationManager.NavigateTo("/grouppage"))">
                                Ir para o Gerenciador de Grupos
                            </button>
                        </div>

                        @if (meusGrupos?.Any() == true)
                        {
                            @foreach (var grupo in meusGrupos)
                            {
                                var (creatorName, followersCount) = grupoMetadados.ContainsKey(grupo.Id_Group)
                                ? grupoMetadados[grupo.Id_Group]
                                : ("Desconhecido", 0);

                                <div class="group-card">
                                    <div class="group-card-left">
                                        <i class="bi bi-people-fill fs-1 text-secondary"></i>
                                    </div>
                                    <div class="group-card-body">
                                        <h5 class="group-title">
                                            <a href="@($"/grouppage/{grupo.Id_Group}")">@grupo.Name</a>
                                        </h5>

                                        <p><i class="bi bi-person"></i> Criado por: @creatorName</p>
                                        <p><i class="bi bi-person-lines-fill"></i> Seguidores: @followersCount</p>

                                        
                                    </div>
                                </div>
                            }


                        }
                        else
                        {
                            <p>Você ainda não criou nenhum grupo.</p>
                        }
                    </div>
                   


                }
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <h3>Você está desconectado</h3>
        <p>Não está autorizado a ver esta página.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string IdRecipe { get; set; }

    string currentSection = "perfil";
    private List<Group> meusGrupos = new();
    private Dictionary<int, (string CreatorName, int FollowersCount)> grupoMetadados = new();

    public User user = new();
    public Recipe recipe = new();
    string newPassword = string.Empty;
    bool isEditing = false;
    bool isPasswordVisible = false;
    bool isEditingName = false;
    bool isEditingEmail = false;
    bool isEditingPassword = false;
    private int grupoSelecionadoParaEditar;
    private int grupoSelecionadoParaEliminar;
    private bool mostrarModalEditar = false;
    private bool mostrarModalEliminar = false;




    protected override async Task OnInitializedAsync()
    {
        var emailUser = await sessionStorage.GetItemAsync<string>("emailAddress");

        if (emailUser != null)
        {
            user = await UserService.GetUserInfo(emailUser);
            meusGrupos = await GroupService.GetUserGroups(user.Id_User);

            foreach (var grupo in meusGrupos)
            {
                var metadata = await GroupService.GetGroupMetadata(grupo.Id_Group);
                grupoMetadados[grupo.Id_Group] = metadata;
            }
        }
    }


    void SetSection(string section)
    {
        currentSection = section;
    }
    void ToggleEditMode() => isEditing = true;

    void TogglePasswordVisibility() => isPasswordVisible = !isPasswordVisible;

    async Task SaveName()
    {
        var result = await UserService.UpdateUser(user);
        if (result) isEditingName = false;
    }

    async Task SaveEmail()
    {
        var result = await UserService.UpdateUser(user);
        if (result) isEditingEmail = false;
    }

    async Task SavePassword()
    {
        if (!string.IsNullOrWhiteSpace(newPassword))
        {
            user.Password = newPassword;
            var result = await UserService.UpdateUser(user);
            if (result)
            {
                newPassword = string.Empty;
                isEditingPassword = false;
            }
        }
        else
        {
            Console.WriteLine("A senha não pode ser vazia.");
        }
    }

    async Task HandleSelectedPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            user.UserPhoto = $"data:{file.ContentType};base64,{base64}";

            var result = await UserService.UpdateUser(user);
            if (result)
            {
                Console.WriteLine("Foto de perfil atualizada.");
            }
        }
    }

    public async Task AddFavorite()
    {
        await RecipeService.AddFavorite(recipe.Id_Recipe, user.Id_User);
    }
}
