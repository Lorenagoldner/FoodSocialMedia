@page "/"

@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage

@layout EmptyLayout

<style>

    body {
        background-color: #fff;
    }
</style>

<div class="container">

    <div class="row align-items-center index-showcase">

        <div class="col-md index-left-panel">
            <a class="navbar-brand" href="#">Foodie</a>
            @*<h4>Nothing brings people together like good food</h4>*@
            <h4>Nada como a boa comida para juntar as pessoas</h4>
            <button class="btn btn-dark" @onclick="ToggleDisplayRegister">Registar</button>
            <button class="btn btn-outline-dark" @onclick="ToggleDisplayLogin">Login</button>
        </div>

        <div class="col-md index-right-panel">

            <img src="img/illustration-index.jpg" alt="" width="440" height="440">
        </div>

    </div>

    <div class="row text-center index-footer">
        @*<h6 class="col">Can you Imagine a World without food?</h6>*@
        <h6 class="col">Consegues imaginar um mundo sem comida?</h6>
        <span>2021 &copy; All rights reserved</span>
    </div>

    <BlazorAppFood.Pages.Login display="@displayLogin"></BlazorAppFood.Pages.Login>
    <BlazorAppFood.Pages.Register display="@displayRegister"></BlazorAppFood.Pages.Register>

</div>

@code {

    @*protected override async Task OnInitializedAsync()
        {
            string user = await sessionStorage.GetItemAsync<string>("emailAddress");

            if(user != null)
            {
                NavigationManager.NavigateTo("/feed");
            }
        }*@


    void login()
    {
        NavigationManager.NavigateTo("/addrecipe");
    }

    public bool displayModalLogin = false;
    public bool displayModalRegister = false;

    public string displayLogin => displayModalLogin ? "block" : "none";
    public string displayRegister => displayModalRegister ? "block" : "none";

    private void ToggleDisplayLogin()
    {
        displayModalLogin = !displayModalLogin;

    }

    private void ToggleDisplayRegister()
    {
        displayModalRegister = !displayModalRegister;

    }
}