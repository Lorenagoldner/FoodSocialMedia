@page "/"
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage

@layout EmptyLayout

<style>
    body {
        background-color: #fff;
    }
</style>

<div class="container">

    <div class="row align-items-center index-showcase">

        <div class="col-md index-left-panel">
            <a class="navbar-brand" href="#">Foodie</a>

            <h4>Nada como a boa comida para juntar as pessoas</h4>

            <button class="btn btn-dark" @onclick="OpenRegister">
                Registar
            </button>

            <button class="btn btn-outline-dark" @onclick="OpenLogin">
                Login
            </button>
        </div>

        <div class="col-md index-right-panel">
            <img src="img/illustration-index.jpg" width="440" height="440">
        </div>

    </div>

    <div class="row text-center index-footer">
        <h6 class="col">Consegues imaginar um mundo sem comida?</h6>
        <span>2021 © All rights reserved</span>
    </div>

    <!-- MODALS -->
    <Login @ref="loginRef" />
    <Register @ref="registerRef" />

</div>
@code {

    private Login? loginRef;
    private Register? registerRef;
    void OpenLogin()
    {
        loginRef?.OpenModal();
    }

    void OpenRegister()
    {
        registerRef?.OpenModal();
    }
}