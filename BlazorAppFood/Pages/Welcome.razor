@page "/welcome"
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage
@inject NavigationManager NavigationManager
@inject ISessionStorageService SessionStorage
@inject IUserRepository UserRepository

@layout EmptyLayout

<div class="fd-empty-layout">
    <header class="fd-empty-header">
        <a href="/" class="fd-brand"><span class="fd-brand__dot"></span> Foodie</a>
    </header>

    <main class="fd-empty-content">
        <div class="fd-onb-card">
            <div aria-hidden="true" style="margin-bottom:8px">
                <svg viewBox="0 0 200 140" width="160">
                    <circle cx="100" cy="70" r="60" fill="#FFE7D2" />
                    <circle cx="100" cy="70" r="42" fill="#fff" />
                    <path d="M70 70 q30 -25 60 0" stroke="#FF6B35" stroke-width="4" fill="none" stroke-linecap="round" />
                    <circle cx="85" cy="62" r="4" fill="#FF6B35" />
                    <circle cx="115" cy="62" r="4" fill="#FF6B35" />
                </svg>
            </div>
            <h1>Foodie</h1>
            <p class="sub">Vamos completar o teu perfil.</p>

            <button class="btn btn-primary btn-lg" style="border-radius:999px; padding:14px 36px" @onclick="Continue">
                LET'S GO
            </button>

            <div class="fd-stepdots">
                <span class="fd-stepdot on"></span>
                <span class="fd-stepdot"></span>
            </div>
            <a href="/feed" class="fd-skip">Saltar estes passos →</a>
        </div>
    </main>

    <footer class="fd-empty-footer">© 2026 Foodie</footer>
</div>

@code {
    private async Task Continue()
    {
        var email = await SessionStorage.GetItemAsync<string>("userEmail");
        var user = await UserRepository.GetUserByEmail(email);

        if (user != null)
        {
            NavigationManager.NavigateTo("/uploadphoto");
        }
        else
        {
            Console.WriteLine("Utilizador não encontrado.");
        }
    }
}
