@page "/feed"
@page "/feed/{TagId:int?}"
@using BlazorAppFood.ComponentsFolder
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage;

@inject IUserRepository UserRepository
@inject IGroupRepository GroupRepository
@inject IRecipeRepository RecipeRepository
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage

<AuthorizeView>
    <Authorized>
        <div class="fd-page-wrap">
            <div class="fd-container">
                <div class="fd-row fd-row-3col">

                    <!-- LEFT -->
                    <aside class="fd-flex-col">

                        <a href="/addrecipe" class="fd-create-card">
                            <span class="icon-circle"><i class="bi bi-plus-lg"></i></span>
                            Criar receita
                        </a>

                        <a href="/categorypage" style="text-decoration:none">
                            <div class="fd-banner" style="min-height:160px">
                                <div class="fd-banner__overlay">
                                    <small class="fd-banner__label">Descobre</small>
                                    <h4 class="fd-banner__title" style="font-size:22px">Cozinha Italiana</h4>
                                </div>
                            </div>
                        </a>

                        <div class="fd-side-card">
                            <h5>Recomendadas para ti</h5>
                            <ul class="fd-h-list">
                                @foreach (var recipe in RecommendedRecipes.Take(3))
                                {
                                    <li>
                                        @if (recipe.Image != null)
                                        {
                                            <span class="fd-thumb"><img src="data:image/jpeg;base64,@Convert.ToBase64String(recipe.Image)" /></span>
                                        }
                                        else
                                        {
                                            <span class="fd-thumb fd-img fd-img--a"><i class="bi bi-egg-fried"></i></span>
                                        }
                                        <a href="/recipepage/@recipe.Id_Recipe">@recipe.NameRecipe</a>
                                    </li>
                                }
                            </ul>
                        </div>

                    </aside>

                    <!-- CENTER -->
                    <section>
                        <div class="fd-flex-between fd-mb-3">
                            <h2 class="fd-page-title" style="margin:0">Feed</h2>
                            <div class="fd-feed-toggle">
                                <button class="@(currentFeedMode == FeedMode.Global ? "active" : "")"
                                        title="Feed Global"
                                        @onclick="() => ChangeFeedMode(FeedMode.Global)">
                                    <i class="bi bi-globe2"></i>
                                </button>
                                <button class="@(currentFeedMode == FeedMode.Following ? "active" : "")"
                                        title="A Seguir"
                                        @onclick="() => ChangeFeedMode(FeedMode.Following)">
                                    <i class="bi bi-people"></i>
                                </button>
                            </div>
                        </div>

                        <p class="fd-muted fd-small fd-mb-3">
                            A mostrar: <strong>@(currentFeedMode == FeedMode.Global ? "Feed Global" : "A Seguir")</strong>
                        </p>

                        @if (listPosts.Count == 0)
                        {
                            <div style="background:var(--blue-soft);color:#1F4D7A;border:1px solid #B8D0EA;border-radius:var(--r-sm);padding:12px 14px;font-size:14px">
                                Nenhuma receita encontrada. Tenta seguir alguém!
                            </div>
                        }

                        @foreach (var recipe in listPosts)
                        {
                            <a href="/recipepage/@recipe.Id_Recipe" class="fd-recipe-card">
                                <div class="fd-recipe-card__img @GetImgClass(recipe.Id_Recipe)">
                                    @if (recipe.Image != null)
                                    {
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(recipe.Image)" alt="@recipe.NameRecipe" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-egg-fried" style="font-size:32px;opacity:.4"></i>
                                    }
                                </div>
                                <div class="fd-recipe-card__body">
                                    <h3 class="fd-recipe-card__title">@recipe.NameRecipe</h3>
                                    <div class="fd-recipe-card__meta">
                                        ★ @recipe.AverageRating.ToString("0.0") &nbsp;·&nbsp; <i class="bi bi-bookmark-fill"></i> @recipe.FavoriteCount
                                    </div>
                                    <div class="fd-recipe-card__meta">
                                        <i class="bi bi-clock"></i> Prep: @TimeFormatter.FormatMinutes(recipe.Prep_Time)
                                        &nbsp;·&nbsp;
                                        <i class="bi bi-fire"></i> Cook: @TimeFormatter.FormatMinutes(recipe.Cook_Time)
                                    </div>
                                    <div class="fd-recipe-card__meta">
                                        @if (recipe.Servings > 0)
                                        {
                                            <span>@recipe.Servings porções &nbsp;·&nbsp; </span>
                                        }
                                        <span class="@GetDifficultyClass(recipe.Difficulty)">
                                            @(recipe.Difficulty switch {
                                                DifficultyLevel.Facil => "Fácil",
                                                DifficultyLevel.Medio => "Médio",
                                                DifficultyLevel.Dificil => "Difícil",
                                                _ => "Fácil"
                                            })
                                        </span>
                                    </div>
                                    <div class="fd-recipe-card__author">
                                        @if (!string.IsNullOrEmpty(recipe.UserPhoto))
                                        {
                                            <img src="@recipe.UserPhoto" class="fd-avatar fd-avatar--sm" style="object-fit:cover" />
                                        }
                                        else
                                        {
                                            <span class="fd-avatar fd-avatar--sm fd-avatar--a"></span>
                                        }
                                        <span style="font-family:var(--font-display);font-size:13px;font-weight:600">@recipe.Username</span>
                                        <span class="fd-muted fd-small">· @recipe.PublishedDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </a>
                        }
                    </section>

                    <!-- RIGHT -->
                    <aside class="fd-flex-col">

                        <div class="fd-side-card">
                            <div class="fd-flex-between fd-mb-2">
                                <h5 style="margin:0">Os Meus Grupos</h5>
                                <a href="/grouppage" class="fd-small">Ver todos</a>
                            </div>
                            @if (userGroups != null && userGroups.Any())
                            {
                                <ul class="fd-h-list">
                                    @foreach (var group in userGroups)
                                    {
                                        <li>
                                            <i class="bi bi-house" style="color:var(--orange)"></i>
                                            <a href="/grouppage/@group.Id_Group">@group.Name</a>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="fd-muted fd-small" style="font-style:italic">Ainda não pertences a nenhum grupo.</p>
                                <div style="display:flex;gap:8px;margin-top:10px">
                                    <button class="fd-btn fd-btn-primary" style="font-size:12px;padding:7px 12px" @onclick="GoToCreateGroup">Criar Grupo</button>
                                    <button class="fd-btn fd-btn-outline" style="font-size:12px;padding:7px 12px" @onclick="GoToSearchGroups">Procurar</button>
                                </div>
                            }
                        </div>

                        <div class="fd-side-card">
                            <h5>As minhas tags</h5>
                            <div style="display:flex;flex-wrap:wrap;gap:6px">
                                @foreach (var tag in userTags)
                                {
                                    <a href="/feed/@tag.IdTag" class="fd-tag-pill">#@tag.NameTag</a>
                                }
                            </div>
                        </div>

                    </aside>

                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="fd-page-wrap">
            <div class="fd-container fd-text-center" style="padding-top:60px">
                <h3>Sessão terminada</h3>
                <p class="fd-muted">Não tens permissão para ver esta página.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    public enum FeedMode { Global, Following }

    FeedMode currentFeedMode = FeedMode.Global;

    public List<Recipe> listPosts = new();
    public List<Recipe> RecommendedRecipes = new();
    public User user = new();
    private List<Group> userGroups = new();
    public List<Tag> userTags = new();

    [Parameter] public int? TagId { get; set; }

    private string? userEmail;

    protected override async Task OnInitializedAsync()
    {
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        userEmail = await sessionStorage.GetItemAsync<string>("userEmail");
        if (string.IsNullOrEmpty(userEmail)) return;

        user = await UserRepository.GetUserByEmail(userEmail);
        if (user == null) return;

        userGroups = await GroupRepository.GetUserGroups(user.Id_User);
        RecommendedRecipes = await RecipeRepository.GetMostFavoritedRecipes();
        userTags = await UserRepository.GetUserTags(user.Id_User);

        await LoadFeed();
    }

    private async Task LoadFeed()
    {
        if (user == null) return;

        // OTIMIZAÇÃO: GetAllRecipesWithCounts traz FavoriteCount já incluído
        // (subquery COUNT). Antes era 1 query GetAllRecipes + N queries
        // GetFavoriteCount por receita. Agora é 1 query só.
        if (currentFeedMode == FeedMode.Global)
            listPosts = (await RecipeRepository.GetAllRecipesWithCounts()).ToList();
        else
            listPosts = (await UserRepository.GetFollowingRecipes(user.Email))
                .OrderByDescending(r => r.PublishedDate).ToList();

        await EnrichRecipes(listPosts);
    }

    private async Task EnrichRecipes(List<Recipe> recipes)
    {
        if (recipes == null || recipes.Count == 0) return;

        // OTIMIZAÇÃO: 1 query batch para todas as tags de todas as receitas
        // em vez de 1 query por receita (eliminação do N+1).
        var recipeIds = recipes.Select(r => r.Id_Recipe).ToList();
        var tagsByRecipe = await RecipeRepository.GetTagsForRecipes(recipeIds);

        foreach (var recipe in recipes)
        {
            recipe.Tags = tagsByRecipe.GetValueOrDefault(recipe.Id_Recipe, new List<Tag>());
            // FavoriteCount já vem populado de GetAllRecipesWithCounts
            // (caso o modo seja "Following", fica em 0 — aceitável para already-followed feed)
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(userEmail) && TagId.HasValue)
        {
            listPosts = await RecipeRepository.GetRecipesByTag(TagId.Value);
            await EnrichRecipes(listPosts);
        }
    }

    private async Task ChangeFeedMode(FeedMode mode)
    {
        if (currentFeedMode == mode) return;
        currentFeedMode = mode;
        await LoadFeed();
    }

    private void GoToCreateGroup() => NavigationManager.NavigateTo("/grouppage");
    private void GoToSearchGroups() => NavigationManager.NavigateTo("/searchgroup");

    public async Task FilterByTag(int tagId)
    {
        listPosts = await RecipeRepository.GetRecipesByTag(tagId);
        await EnrichRecipes(listPosts);
    }

    private string GetDifficultyClass(DifficultyLevel level) => level switch
    {
        DifficultyLevel.Facil => "fd-badge-success",
        DifficultyLevel.Medio => "fd-badge-warning",
        DifficultyLevel.Dificil => "fd-badge-danger",
        _ => "fd-badge-success"
    };

    private static readonly string[] ImgClasses = { "fd-img--a", "fd-img--b", "fd-img--c", "fd-img--d", "fd-img--e" };
    private string GetImgClass(int id) => ImgClasses[id % ImgClasses.Length];
}
