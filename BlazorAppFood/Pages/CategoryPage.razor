@page "/categorypage"
@page "/categorypage/{IdCategory:int}"
@using BlazorAppFood.ComponentsFolder
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage;

@inject IRecipeRepository RecipeRepository
@inject ITagRepository TagRepository
@inject IGroupRepository GroupRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage

<AuthorizeView>
    <Authorized>
        <div class="fd-page-wrap">
            <div class="fd-container">

                @if (isLoading)
                {
                    <p class="fd-muted" style="padding:40px 0;text-align:center">A carregar...</p>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:60px 1fr;gap:24px;align-items:start">

                        <!-- Sidebar icons -->
                        <aside style="display:flex;flex-direction:column;align-items:center;gap:12px;padding-top:4px">
                            <a href="/feed" class="fd-icon-btn fd-icon-btn--orange" title="Home"><i class="bi bi-house"></i></a>
                            <a href="/addrecipe" class="fd-icon-btn" title="Publicar"><i class="bi bi-plus-lg"></i></a>
                            <a href="/favorites" class="fd-icon-btn" title="Favoritos"><i class="bi bi-bookmark"></i></a>
                        </aside>

                        <section>
                            <!-- Hero banner -->
                            <div class="fd-banner">
                                <div class="fd-banner__overlay">
                                    <small class="fd-banner__label">Sugerido para si...</small>
                                    <h4 class="fd-banner__title">@(currentCategory?.Description ?? "Descobrir")</h4>
                                    <p class="fd-banner__sub">@GetCategoryTagline(currentCategory?.Description)</p>
                                </div>
                            </div>

                            <!-- Row 1: 3 ranking cards -->
                            <div class="fd-grid-3 fd-mt-4">

                                <!-- Mais guardadas -->
                                <div class="fd-side-card">
                                    <h5><i class="bi bi-bookmark-fill"></i> Mais guardadas</h5>
                                    @if (!mostBookmarked.Any())
                                    {
                                        <p class="fd-muted fd-small" style="font-style:italic">Sem dados disponíveis.</p>
                                    }
                                    <ul class="fd-h-list">
                                        @foreach (var r in mostBookmarked)
                                        {
                                            <li style="cursor:pointer" @onclick="@(() => NavigationManager.NavigateTo("/recipepage/" + r.Id_Recipe))">
                                                @if (r.Image != null)
                                                {
                                                    <span class="fd-thumb"><img src="data:image/jpeg;base64,@Convert.ToBase64String(r.Image)" /></span>
                                                }
                                                else
                                                {
                                                    <span class="fd-thumb fd-img fd-img--a"><i class="bi bi-bookmark-fill"></i></span>
                                                }
                                                <span>
                                                    @r.NameRecipe
                                                    <br /><small class="fd-muted">@r.FavoriteCount guardadas</small>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>

                                <!-- Maior avaliação -->
                                <div class="fd-side-card">
                                    <h5><i class="bi bi-star-fill"></i> Maior avaliação</h5>
                                    @if (!topRated.Any())
                                    {
                                        <p class="fd-muted fd-small" style="font-style:italic">Sem dados disponíveis.</p>
                                    }
                                    <ul class="fd-h-list">
                                        @foreach (var r in topRated)
                                        {
                                            <li style="cursor:pointer" @onclick="@(() => NavigationManager.NavigateTo("/recipepage/" + r.Id_Recipe))">
                                                @if (r.Image != null)
                                                {
                                                    <span class="fd-thumb"><img src="data:image/jpeg;base64,@Convert.ToBase64String(r.Image)" /></span>
                                                }
                                                else
                                                {
                                                    <span class="fd-thumb fd-img fd-img--c"><i class="bi bi-star-fill"></i></span>
                                                }
                                                <span>
                                                    @r.NameRecipe
                                                    <br /><small class="fd-muted">★ @r.AverageRating.ToString("0.0")</small>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>

                                <!-- Top Chefs -->
                                <div class="fd-side-card">
                                    <h5><i class="bi bi-trophy"></i> Top Chefs da semana</h5>
                                    @if (!topChefs.Any())
                                    {
                                        <p class="fd-muted fd-small" style="font-style:italic">Sem dados disponíveis.</p>
                                    }
                                    <ul class="fd-h-list">
                                        @foreach (var chef in topChefs)
                                        {
                                            <li style="cursor:pointer" @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + chef.UserId))">
                                                @if (!string.IsNullOrEmpty(chef.UserPhoto))
                                                {
                                                    <img src="@chef.UserPhoto" class="fd-avatar fd-avatar--sm" style="object-fit:cover" />
                                                }
                                                else
                                                {
                                                    <span class="fd-avatar fd-avatar--sm fd-avatar--a"></span>
                                                }
                                                <span>
                                                    @chef.Username
                                                    <br /><small class="fd-muted">@FormatSaves(chef.TotalFavorites) saves</small>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>

                            </div>

                            <!-- Row 2: Grupos -->
                            <div class="fd-grid-2 fd-mt-2" style="margin-top:18px">
                                <div class="fd-side-card">
                                    <h5><i class="bi bi-people"></i> Grupos de @(currentCategory?.Description ?? "Culinária")</h5>
                                    @if (!categoryGroups.Any())
                                    {
                                        <p class="fd-muted fd-small" style="font-style:italic">Nenhum grupo encontrado.</p>
                                        <button class="fd-btn fd-btn-primary" style="margin-top:10px;font-size:13px;padding:8px 14px"
                                                @onclick="@(() => NavigationManager.NavigateTo("/grouppage"))">
                                            Criar Grupo
                                        </button>
                                    }
                                    else
                                    {
                                        <ul class="fd-h-list">
                                            @foreach (var group in categoryGroups.Take(5))
                                            {
                                                <li>
                                                    <i class="bi bi-house" style="color:var(--orange)"></i>
                                                    <a href="/grouppage/@group.Id_Group">@group.Name</a>
                                                    @if (groupMemberCounts.TryGetValue(group.Id_Group, out var count))
                                                    {
                                                        <span class="fd-muted fd-small" style="margin-left:auto">@count membros</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>

                        </section>

                    </div>
                }

            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="fd-page-wrap">
            <div class="fd-container fd-text-center" style="padding-top:60px">
                <h3>Sessão terminada</h3>
                <p class="fd-muted">Não tens permissão para ver esta página.</p>
                <a class="fd-btn fd-btn-primary" href="/login">Iniciar sessão</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {

    [Parameter]
    public int IdCategory { get; set; }

    private User user = new User();
    private CategoryWithTags? currentCategory;
    private List<Recipe> categoryRecipes = new();

    private List<Recipe> mostBookmarked = new();
    private List<Recipe> topRated = new();
    private List<ChefStat> topChefs = new();
    private List<Group> categoryGroups = new();
    private Dictionary<int, int> groupMemberCounts = new();

    private bool isLoading = true;

    private class ChefStat
    {
        public int UserId { get; set; }
        public string Username { get; set; } = "";
        public string? UserPhoto { get; set; }
        public int TotalFavorites { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        string? emailUser = await sessionStorage.GetItemAsync<string>("userEmail");
        if (emailUser != null)
            user = await UserRepository.GetUserInfo(emailUser);

        await LoadPageData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageData();
    }

    private async Task LoadPageData()
    {
        isLoading = true;

        var allCategories = await TagRepository.GetCategoriesWithTags();

        if (IdCategory > 0)
            currentCategory = allCategories.FirstOrDefault(c => c.IdCategory == IdCategory);
        else if (allCategories.Any())
            currentCategory = allCategories.First();

        categoryRecipes = await LoadCategoryRecipes();
        var categoryIds = categoryRecipes.Select(r => r.Id_Recipe).ToHashSet();

        var globalMostFavorited = await RecipeRepository.GetMostFavoritedRecipes();
        mostBookmarked = globalMostFavorited
            .Where(r => categoryIds.Contains(r.Id_Recipe))
            .Take(3).ToList();

        if (mostBookmarked.Count < 3)
        {
            var extra = categoryRecipes
                .Where(r => mostBookmarked.All(b => b.Id_Recipe != r.Id_Recipe))
                .OrderByDescending(r => r.FavoriteCount)
                .Take(3 - mostBookmarked.Count);
            mostBookmarked.AddRange(extra);
        }

        topRated = categoryRecipes
            .Where(r => r.AverageRating > 0)
            .OrderByDescending(r => r.AverageRating)
            .Take(3).ToList();

        topChefs = categoryRecipes
            .GroupBy(r => new { r.Id_User, r.Username, r.UserPhoto })
            .Select(g => new ChefStat
            {
                UserId = g.Key.Id_User,
                Username = g.Key.Username,
                UserPhoto = g.Key.UserPhoto,
                TotalFavorites = g.Sum(r => r.FavoriteCount)
            })
            .OrderByDescending(c => c.TotalFavorites)
            .Take(3).ToList();

        categoryGroups = await GroupRepository.GetAllGroups();
        groupMemberCounts = new();
        foreach (var group in categoryGroups.Take(5))
        {
            var metadata = await GroupRepository.GetGroupMetadata(group.Id_Group);
            groupMemberCounts[group.Id_Group] = metadata.FollowersCount;
        }

        isLoading = false;
    }

    private async Task<List<Recipe>> LoadCategoryRecipes()
    {
        if (currentCategory?.Tags == null || !currentCategory.Tags.Any())
            return new List<Recipe>();

        var result = new List<Recipe>();
        foreach (var tag in currentCategory.Tags)
        {
            var tagRecipes = await RecipeRepository.GetRecipesByTag(tag.IdTag);
            foreach (var r in tagRecipes)
            {
                if (!result.Any(x => x.Id_Recipe == r.Id_Recipe))
                {
                    r.FavoriteCount = await RecipeRepository.GetFavoriteCount(r.Id_Recipe);
                    result.Add(r);
                }
            }
        }
        return result;
    }

    private string GetCategoryTagline(string? categoryName)
    {
        return categoryName?.ToLower() switch
        {
            "cozinha italiana" => "Massa, pão e azeite. As três coisas que tornam tudo melhor.",
            "cozinha portuguesa" => "Bacalhau, petiscos e muito amor à mesa.",
            "cozinha asiática" => "Especiarias, equilíbrio e sabores que surpreendem.",
            "sobremesas" => "Porque a vida é mais doce com uma boa sobremesa.",
            "vegetariano" => "Simples, colorido e cheio de sabor.",
            _ => "Descobre as melhores receitas desta categoria."
        };
    }

    private string FormatSaves(int saves)
        => saves >= 1000 ? $"{saves / 1000.0:0.#}k" : saves.ToString();
}
