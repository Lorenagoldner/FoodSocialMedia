@page "/categorypage"
@page "/categorypage/{IdCategory:int}"
@using BlazorAppFood.ComponentsFolder
@using BlazorAppFood.Models
@using BlazorAppFood.Repositories
@using Blazored.SessionStorage;

@inject IRecipeRepository RecipeRepository
@inject ITagRepository TagRepository
@inject IGroupRepository GroupRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage

<AuthorizeView>
    <Authorized>

        <div class="container">

            @if (isLoading)
            {
                <div class="text-center mt-5">
                    <div class="spinner-border text-danger" role="status"></div>
                    <p class="text-muted mt-2">A carregar...</p>
                </div>
            }
            else
            {
                <!-- Hero Banner -->
                <div class="card card-custom text-white mt-3"
                     style="background-image: url('img/cozinha-italiana.jpg'); background-size: cover; background-position: center; min-height: 200px; display: flex; align-items: flex-end;">
                    <div style="background: linear-gradient(to top, rgba(0,0,0,0.65) 60%, transparent); border-radius: 8px; padding: 24px; width: 100%;">
                        <p class="mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.1em; opacity: 0.85;">Sugerido para si...</p>
                        <h2 class="mb-1 fw-bold">@(currentCategory?.Description ?? "Descobrir")</h2>
                        <p class="mb-0" style="font-size: 0.9rem; opacity: 0.9;">
                            @GetCategoryTagline(currentCategory?.Description)
                        </p>
                    </div>
                </div>

                <!-- Linha 1: 2 cards de ranking -->
                <div class="row mt-2">

                    <!-- Mais guardadas -->
                    <div class="col-md-6">
                        <div class="card card-custom">
                            <div class="card-custom-header">
                                <h5> Mais guardadas</h5>
                            </div>
                            <div class="card-custom-body">
                                @if (!mostBookmarked.Any())
                                {
                                    <p class="text-muted">Sem dados disponíveis.</p>
                                }
                                @foreach (var r in mostBookmarked)
                                {
                                    <div class="d-flex align-items-center gap-2 mb-3"
                                         style="cursor:pointer;"
                                         @onclick="@(() => NavigationManager.NavigateTo("/recipepage/" + r.Id_Recipe))">
                                        <div style="width:40px; height:40px; flex-shrink:0; border-radius:6px; overflow:hidden; background:#f1f1f1; display:flex; align-items:center; justify-content:center;">
                                            @if (r.Image != null)
                                            {
                                                var img = $"data:image/jpeg;base64,{Convert.ToBase64String(r.Image)}";
                                                <img src="@img" width="40" height="40" style="object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-bookmark-fill" style="font-size:1.2rem; color:#ccc;"></i>
                                            }
                                        </div>
                                        <div>
                                            <div style="font-size:0.9rem;">@r.NameRecipe</div>
                                            <small class="text-muted"><i class="bi bi-bookmarks-fill" style="font-size:0.7rem;"></i> @r.FavoriteCount guardadas</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Maior avaliação -->
                    <div class="col-md-6">
                        <div class="card card-custom">
                            <div class="card-custom-header">
                                <h5>Maior avaliação</h5>
                            </div>
                            <div class="card-custom-body">
                                @if (!topRated.Any())
                                {
                                    <p class="text-muted">Sem dados disponíveis.</p>
                                }
                                @foreach (var r in topRated)
                                {
                                    <div class="d-flex align-items-center gap-2 mb-3"
                                         style="cursor:pointer;"
                                         @onclick="@(() => NavigationManager.NavigateTo("/recipepage/" + r.Id_Recipe))">
                                        <div style="width:40px; height:40px; flex-shrink:0; border-radius:6px; overflow:hidden; background:#f1f1f1; display:flex; align-items:center; justify-content:center;">
                                            @if (r.Image != null)
                                            {
                                                var img = $"data:image/jpeg;base64,{Convert.ToBase64String(r.Image)}";
                                                <img src="@img" width="40" height="40" style="object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-star-fill" style="font-size:1.2rem; color:#ccc;"></i>
                                            }
                                        </div>
                                        <div>
                                            <div style="font-size:0.9rem;">@r.NameRecipe</div>
                                            <small class="text-muted"><i class="bi bi-star-fill text-warning" style="font-size:0.7rem;"></i> @r.AverageRating.ToString("0.0")</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Linha 2: Top Chefs + Grupos -->
                <div class="row">

                    <!-- Top Chefs da semana -->
                    <div class="col-md-6">
                        <div class="card card-custom">
                            <div class="card-custom-header">
                                <h5> Top Chefs da semana</h5>
                            </div>
                            <div class="card-custom-body">
                                @if (!topChefs.Any())
                                {
                                    <p class="text-muted">Sem dados disponíveis.</p>
                                }
                                @foreach (var chef in topChefs)
                                {
                                    <div class="d-flex align-items-center gap-3 mb-3"
                                         style="cursor:pointer;"
                                         @onclick="@(() => NavigationManager.NavigateTo("/profilepage/" + chef.UserId))">
                                        @if (!string.IsNullOrEmpty(chef.UserPhoto))
                                        {
                                            <img src="@chef.UserPhoto" class="rounded-circle" width="40" height="40" style="object-fit:cover; flex-shrink:0;" />
                                        }
                                        else
                                        {
                                            <img src="img/avatar2.jpg" class="rounded-circle" width="40" height="40" style="flex-shrink:0;" />
                                        }
                                        <div>
                                            <div style="font-size:0.9rem; font-weight:600;">@chef.Username</div>
                                            <small class="text-muted">@FormatSaves(chef.TotalFavorites) saves</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Grupos da categoria -->
                    <div class="col-md-6">
                        <div class="card card-custom">
                            <div class="card-custom-header">
                                <h5> Grupos de @(currentCategory?.Description ?? "Culinária")</h5>
                            </div>
                            <div class="card-custom-body">
                                @if (!categoryGroups.Any())
                                {
                                    <p class="text-muted">Nenhum grupo encontrado.</p>
                                    <button class="btn btn-sm btn-primary mt-2" @onclick="@(() => NavigationManager.NavigateTo("/grouppage"))">
                                        Criar Grupo
                                    </button>
                                }
                                else
                                {
                                    <ul class="list-unstyled">
                                        @foreach (var group in categoryGroups.Take(5))
                                        {
                                            <li class="mb-2">
                                                <a href="/grouppage/@group.Id_Group" class="d-flex align-items-center justify-content-between">
                                                    <span class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-house-door"></i>
                                                        @group.Name
                                                    </span>
                                                    @if (groupMemberCounts.TryGetValue(group.Id_Group, out var count))
                                                    {
                                                        <small class="text-muted">@count membros</small>
                                                    }
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            }

        </div>

    </Authorized>
    <NotAuthorized>
        <div class="container mt-5 text-center">
            <h3>Sessão terminada</h3>
            <p>Não tens permissão para ver esta página.</p>
            <a class="btn btn-primary" href="/login">Iniciar sessão</a>
        </div>
    </NotAuthorized>
</AuthorizeView>


@code {

    [Parameter]
    public int IdCategory { get; set; }

    private User user = new User();
    private CategoryWithTags? currentCategory;
    private List<Recipe> categoryRecipes = new();

    // Listas para os cards de ranking
    private List<Recipe> mostBookmarked = new();
    private List<Recipe> topRated = new();

    // Top Chefs
    private List<ChefStat> topChefs = new();

    // Grupos
    private List<Group> categoryGroups = new();
    private Dictionary<int, int> groupMemberCounts = new();

    private bool isLoading = true;

    // Classe auxiliar para top chefs
    private class ChefStat
    {
        public int UserId { get; set; }
        public string Username { get; set; } = "";
        public string? UserPhoto { get; set; }
        public int TotalFavorites { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        string? emailUser = await sessionStorage.GetItemAsync<string>("userEmail");
        if (emailUser != null)
            user = await UserRepository.GetUserInfo(emailUser);

        await LoadPageData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageData();
    }

    private async Task LoadPageData()
    {
        isLoading = true;

        // Carregar categorias com tags
        var allCategories = await TagRepository.GetCategoriesWithTags();

        if (IdCategory > 0)
            currentCategory = allCategories.FirstOrDefault(c => c.IdCategory == IdCategory);
        else if (allCategories.Any())
            currentCategory = allCategories.First();

        // Carregar receitas da categoria (agrega por todas as tags)
        categoryRecipes = await LoadCategoryRecipes();

        // IDs das receitas desta categoria (para filtrar os rankings globais)
        var categoryIds = categoryRecipes.Select(r => r.Id_Recipe).ToHashSet();

        // Mais guardadas: usa GetMostFavoritedRecipes (SQL com agregação correcta),
        // filtrado pelas receitas desta categoria
        var globalMostFavorited = await RecipeRepository.GetMostFavoritedRecipes();
        mostBookmarked = globalMostFavorited
            .Where(r => categoryIds.Contains(r.Id_Recipe))
            .Take(3).ToList();

        // Se não chegarem 3 do top global, complementa com os da categoria ordenados
        if (mostBookmarked.Count < 3)
        {
            var extra = categoryRecipes
                .Where(r => mostBookmarked.All(b => b.Id_Recipe != r.Id_Recipe))
                .OrderByDescending(r => r.FavoriteCount)
                .Take(3 - mostBookmarked.Count);
            mostBookmarked.AddRange(extra);
        }

        topRated = categoryRecipes
            .Where(r => r.AverageRating > 0)
            .OrderByDescending(r => r.AverageRating)
            .Take(3).ToList();

        // Top Chefs: agrupa receitas por autor, soma favoritos
        topChefs = categoryRecipes
            .GroupBy(r => new { r.Id_User, r.Username, r.UserPhoto })
            .Select(g => new ChefStat
            {
                UserId = g.Key.Id_User,
                Username = g.Key.Username,
                UserPhoto = g.Key.UserPhoto,
                TotalFavorites = g.Sum(r => r.FavoriteCount)
            })
            .OrderByDescending(c => c.TotalFavorites)
            .Take(3).ToList();

        // Grupos — todos os grupos com contagem de membros
        categoryGroups = await GroupRepository.GetAllGroups();
        groupMemberCounts = new();
        foreach (var group in categoryGroups.Take(5))
        {
            var metadata = await GroupRepository.GetGroupMetadata(group.Id_Group);
            groupMemberCounts[group.Id_Group] = metadata.FollowersCount;
        }

        isLoading = false;
    }

    private async Task<List<Recipe>> LoadCategoryRecipes()
    {
        if (currentCategory?.Tags == null || !currentCategory.Tags.Any())
            return new List<Recipe>();

        var result = new List<Recipe>();
        foreach (var tag in currentCategory.Tags)
        {
            var tagRecipes = await RecipeRepository.GetRecipesByTag(tag.IdTag);
            foreach (var r in tagRecipes)
            {
                if (!result.Any(x => x.Id_Recipe == r.Id_Recipe))
                {
                    r.FavoriteCount = await RecipeRepository.GetFavoriteCount(r.Id_Recipe);
                    result.Add(r);
                }
            }
        }
        return result;
    }

    private string GetCategoryTagline(string? categoryName)
    {
        return categoryName?.ToLower() switch
        {
            "cozinha italiana" => "Massa, pão e azeite. As três coisas que tornam tudo melhor.",
            "cozinha portuguesa" => "Bacalhau, petiscos e muito amor à mesa.",
            "cozinha asiática" => "Especiarias, equilíbrio e sabores que surpreendem.",
            "sobremesas" => "Porque a vida é mais doce com uma boa sobremesa.",
            "vegetariano" => "Simples, colorido e cheio de sabor.",
            _ => "Descobre as melhores receitas desta categoria."
        };
    }

    private string FormatSaves(int saves)
        => saves >= 1000 ? $"{saves / 1000.0:0.#}k" : saves.ToString();
}
